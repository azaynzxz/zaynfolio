---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Achmad Zaini | 2D Motion Designer for YouTube and Marketing',
  description = 'Portfolio of Achmad Zaini, a 2D motion designer. Rigged 2D motion for YouTube series and marketing posters, with 124 episodes delivered. Remote worldwide.'
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Achmad Zaini" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site || 'https://zaynfolio.com')} />
    {Astro.props.image && <meta property="og:image" content={Astro.props.image.startsWith('http') ? Astro.props.image : new URL(Astro.props.image, Astro.site || 'https://zaynfolio.com')} />}

    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />

    <!-- Fonts: DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,700;0,9..40,900;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <!-- Global Styles -->
    <style is:global>
      @import '../styles/global.css';
    </style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
    <!-- Named slot for per-page <head> additions (canonical, extra OG, LD+JSON) -->
    <slot name="head" />
  </head>
  <body>
    <!-- Decorative Grid Lines -->
    <div class="grid-lines" aria-hidden="true">
      <div class="container">
        <div class="grid">
          {Array.from({ length: 12 }).map(() => (
            <div class="grid-lines__col"></div>
          ))}
        </div>
      </div>
    </div>

    <!-- Navigation -->
    <nav class="nav" id="main-nav">
      <div class="container">
        <div class="nav__inner">
          <div class="nav__brand" id="nav-brand">
            <a
              href="/"
              class="nav__avatar-link"
              id="nav-avatar-link"
              aria-label="Achmad Zaini - Back to Home"
              title="Achmad Zaini - Home"
            >
              <img
                src="/img/avatar_bw.webp"
                alt="Achmad Zaini"
                class="nav__avatar-img"
                width="36"
                height="36"
                loading="eager"
              />
            </a>
            <button
              type="button"
              class="nav__avatar-details-btn"
              id="nav-avatar-details-btn"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-label="View full photo details"
            >
              See Details
            </button>
          </div>
          <div class="nav__links">
            <a href="/work" class:list={["nav__link", { "nav__link--active": currentPath === "/work" || currentPath === "/work/" }]} id="nav-work">Work</a>
            <a href="/gallery" class:list={["nav__link", { "nav__link--active": currentPath === "/gallery" || currentPath === "/gallery/" }]} id="nav-gallery">Gallery</a>
            <a href="/contact" class:list={["nav__link", { "nav__link--active": currentPath === "/contact" || currentPath === "/contact/" }]} id="nav-contact">Contact</a>
            <button class="nav__theme-toggle" id="theme-toggle" aria-label="Toggle theme">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
                <path d="M8 1a7 7 0 0 1 0 14V1z" fill="currentColor"/>
              </svg>
            </button>
          </div>

          <!-- Mobile menu button -->
          <button class="nav__mobile-toggle" id="mobile-menu-toggle" aria-label="Toggle menu">
            <span class="nav__mobile-line"></span>
            <span class="nav__mobile-line"></span>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Navigation Dropdown -->
    <div class="mobile-dropdown-backdrop" id="mobile-dropdown-backdrop"></div>
    <div class="mobile-dropdown" id="mobile-dropdown" aria-hidden="true" role="dialog" aria-label="Mobile navigation">
      <div class="container">
        <div class="mobile-dropdown__inner">
          <ul class="mobile-dropdown__list">
            <li class="mobile-dropdown__item">
              <a href="/" class:list={["mobile-dropdown__link", { "mobile-dropdown__link--active": currentPath === "/" }]}>
                <span class="mobile-dropdown__num">00</span>
                <span class="mobile-dropdown__title">Home</span>
                <svg class="mobile-dropdown__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 12l8-8M12 12V4H4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </li>
            <li class="mobile-dropdown__item">
              <a href="/work" class:list={["mobile-dropdown__link", { "mobile-dropdown__link--active": currentPath === "/work" || currentPath === "/work/" }]}>
                <span class="mobile-dropdown__num">01</span>
                <span class="mobile-dropdown__title">Work</span>
                <svg class="mobile-dropdown__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 12l8-8M12 12V4H4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </li>
            <li class="mobile-dropdown__item">
              <a href="/gallery" class:list={["mobile-dropdown__link", { "mobile-dropdown__link--active": currentPath === "/gallery" || currentPath === "/gallery/" }]}>
                <span class="mobile-dropdown__num">02</span>
                <span class="mobile-dropdown__title">Gallery</span>
                <svg class="mobile-dropdown__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 12l8-8M12 12V4H4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </li>
            <li class="mobile-dropdown__item">
              <a href="/contact" class:list={["mobile-dropdown__link", { "mobile-dropdown__link--active": currentPath === "/contact" || currentPath === "/contact/" }]}>
                <span class="mobile-dropdown__num">03</span>
                <span class="mobile-dropdown__title">Contact</span>
                <svg class="mobile-dropdown__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M4 12l8-8M12 12V4H4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </li>
          </ul>

          <div class="mobile-dropdown__footer">
            <div class="mobile-dropdown__status">
              <span class="mobile-dropdown__dot" aria-hidden="true"></span>
              <span>Available for remote projects</span>
            </div>
            <button type="button" class="mobile-dropdown__theme" id="mobile-theme-toggle" aria-label="Toggle theme">
              <span>Theme</span>
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
                <path d="M8 1a7 7 0 0 1 0 14V1z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Avatar Lightbox Modal -->
    <div
      class="avatar-modal"
      id="avatar-modal"
      aria-hidden="true"
      role="dialog"
      aria-modal="true"
      aria-labelledby="am-name"
    >
      <div class="avatar-modal__backdrop" id="am-backdrop"></div>
      <div class="avatar-modal__dialog" role="document">
        <button
          type="button"
          class="avatar-modal__close"
          id="am-close"
          aria-label="Close photo preview"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <path d="M2 2l12 12M14 2L2 14" />
          </svg>
        </button>

        <div class="avatar-modal__media">
          <img
            src="/img/my_photo.webp"
            alt="Achmad Zaini portrait"
            class="avatar-modal__img"
            loading="lazy"
          />
        </div>

        <div class="avatar-modal__content">
          <div class="avatar-modal__status">
            <span class="avatar-modal__dot" aria-hidden="true"></span>
            <span>Available for remote projects</span>
          </div>
          <h2 class="avatar-modal__name" id="am-name">Achmad Zaini</h2>
          <p class="avatar-modal__title">2D Motion Designer &bull; Production Supervisor</p>
          <p class="avatar-modal__location">Palembang, Indonesia &bull; UTC+7</p>

          <div class="avatar-modal__links">
            <a href="/contact" class="avatar-modal__btn avatar-modal__btn--primary">Start a project</a>
            <a href="/" class="avatar-modal__btn avatar-modal__btn--ghost">Go to home</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <hr class="rule" />
        <div class="footer__inner">
          <span class="footer__copy">&copy; {new Date().getFullYear()} Achmad Zaini</span>
          <div class="footer__links">
            <a href="/work" class="footer__link">Work</a>
            <a href="/gallery" class="footer__link">Gallery</a>
            <a href="/contact" class="footer__link">Contact</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scripts -->
    <script>
      function initBase() {
        // Theme toggle
        const themeToggle = document.getElementById('theme-toggle');
        const themes = ['light', 'dark', 'accent'];
        
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);
        let currentThemeIndex = themes.indexOf(savedTheme);

        themeToggle?.addEventListener('click', () => {
          currentThemeIndex = (currentThemeIndex + 1) % themes.length;
          const newTheme = themes[currentThemeIndex];
          document.documentElement.setAttribute('data-theme', newTheme);
          localStorage.setItem('theme', newTheme);
        });

        // Mobile dropdown menu
        const mobileToggle = document.getElementById('mobile-menu-toggle');
        const mobileDropdown = document.getElementById('mobile-dropdown');
        const mobileBackdrop = document.getElementById('mobile-dropdown-backdrop');
        const mobileThemeToggle = document.getElementById('mobile-theme-toggle');

        function openMobileMenu() {
          mobileDropdown?.classList.add('mobile-dropdown--open');
          mobileDropdown?.setAttribute('aria-hidden', 'false');
          mobileBackdrop?.classList.add('mobile-dropdown-backdrop--open');
          mobileToggle?.classList.add('nav__mobile-toggle--open');
          mobileToggle?.setAttribute('aria-expanded', 'true');
        }

        function closeMobileMenu() {
          mobileDropdown?.classList.remove('mobile-dropdown--open');
          mobileDropdown?.setAttribute('aria-hidden', 'true');
          mobileBackdrop?.classList.remove('mobile-dropdown-backdrop--open');
          mobileToggle?.classList.remove('nav__mobile-toggle--open');
          mobileToggle?.setAttribute('aria-expanded', 'false');
        }

        mobileToggle?.addEventListener('click', () => {
          const isOpen = mobileDropdown?.classList.contains('mobile-dropdown--open');
          if (isOpen) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
        });

        mobileBackdrop?.addEventListener('click', closeMobileMenu);

        mobileDropdown?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeMobileMenu);
        });

        mobileThemeToggle?.addEventListener('click', () => {
          currentThemeIndex = (currentThemeIndex + 1) % themes.length;
          const newTheme = themes[currentThemeIndex];
          document.documentElement.setAttribute('data-theme', newTheme);
          localStorage.setItem('theme', newTheme);
        });

        // Avatar details modal
        const avatarDetailsBtn = document.getElementById('nav-avatar-details-btn');
        const avatarModal = document.getElementById('avatar-modal');
        const avatarClose = document.getElementById('am-close');
        const avatarBackdrop = document.getElementById('am-backdrop');

        function openAvatar() {
          if (!avatarModal) return;
          avatarModal.classList.add('avatar-modal--active');
          avatarModal.setAttribute('aria-hidden', 'false');
          avatarDetailsBtn?.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
        }

        function closeAvatar() {
          if (!avatarModal) return;
          avatarModal.classList.remove('avatar-modal--active');
          avatarModal.setAttribute('aria-hidden', 'true');
          avatarDetailsBtn?.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }

        avatarDetailsBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openAvatar();
        });
        avatarClose?.addEventListener('click', closeAvatar);
        avatarBackdrop?.addEventListener('click', closeAvatar);

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && avatarModal?.classList.contains('avatar-modal--active')) {
            closeAvatar();
          }
        });
      }

      document.addEventListener('astro:page-load', initBase);
    </script>

    <!-- Global Media Protection -->
    <script>
      document.addEventListener('contextmenu', (e) => {
        if (e.target instanceof HTMLImageElement || e.target instanceof HTMLVideoElement) {
          e.preventDefault();
        }
      });
      document.addEventListener('dragstart', (e) => {
        if (e.target instanceof HTMLImageElement || e.target instanceof HTMLVideoElement) {
          e.preventDefault();
        }
      });
    </script>

    <script>
      // GSAP + Lenis (loaded as module)
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      let lenisInstance: any = null;

      // Asynchronous Lenis initialization in the background
      async function initLenis() {
        if (lenisInstance) {
          lenisInstance.destroy();
          lenisInstance = null;
        }

        const { default: Lenis } = await import('lenis');
        lenisInstance = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        });

        lenisInstance.on('scroll', ScrollTrigger.update);
        
        const tickHandler = (time: number) => {
          if (lenisInstance) {
            lenisInstance.raf(time * 1000);
          }
        };
        gsap.ticker.add(tickHandler);
        
        document.addEventListener('astro:before-preparation', () => {
          gsap.ticker.remove(tickHandler);
          ScrollTrigger.getAll().forEach(t => t.kill());
        }, { once: true });

        gsap.ticker.lagSmoothing(0);
      }

      // Synchronous layout animation initialization
      function initScrollAndAnimations() {

        // Animate reveal elements
        gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
          gsap.fromTo(el, { autoAlpha: 0, y: 20 }, {
            autoAlpha: 1,
            y: 0,
            duration: 0.8,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 90%',
              once: true,
            },
          });
        });

        // Animate rule lines
        gsap.utils.toArray<HTMLElement>('.reveal-line').forEach((el) => {
          gsap.fromTo(el, { scaleX: 0, autoAlpha: 0 }, {
            autoAlpha: 1,
            scaleX: 1,
            duration: 1,
            ease: 'power3.inOut',
            scrollTrigger: {
              trigger: el,
              start: 'top 90%',
              once: true,
            },
          });
        });

        // Stagger work rows
        const workRows = gsap.utils.toArray<HTMLElement>('.work-row');
        if (workRows.length) {
          gsap.fromTo(workRows, { autoAlpha: 0, y: 30 }, {
            autoAlpha: 1,
            y: 0,
            duration: 0.6,
            stagger: 0.1,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: workRows[0],
              start: 'top 85%',
              once: true,
            },
          });
        }

        // Initialize Lenis scroll asynchronously in the background
        initLenis();

        // Refresh ScrollTrigger once DOM layout has fully settled
        setTimeout(() => {
          ScrollTrigger.refresh();
        }, 150);
      }

      document.addEventListener('astro:page-load', initScrollAndAnimations);
    </script>
  </body>
</html>

<style>
  /* ── Navigation ────────────────────────────────────────────── */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg);
    transition: background-color var(--duration-slow) var(--ease-out);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .nav__brand {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .nav__avatar-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 50%;
    border: 1.5px solid var(--rule);
    background: #FFFFFF;
    overflow: hidden;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                box-shadow var(--duration-fast) var(--ease-out);
  }

  .nav__avatar-link:hover {
    transform: scale(1.06);
    border-color: var(--fg);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .nav__avatar-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .nav__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #FFFFFF;
  }

  .nav__avatar-details-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family);
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    line-height: 1;
    padding: 5px 9px;
    border: 1px solid var(--rule);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    pointer-events: none;
    transition: opacity var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
  }

  .nav__brand:hover .nav__avatar-details-btn,
  .nav__brand:focus-within .nav__avatar-details-btn {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  .nav__avatar-details-btn:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .nav__avatar-details-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav__link {
    font-size: var(--fs-label);
    font-weight: var(--fw-regular);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
    position: relative;
    padding-bottom: 2px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--fg);
  }

  .nav__link:hover::after {
    transform: scaleX(1);
  }

  .nav__link--active {
    color: var(--fg);
  }

  .nav__link--active::after {
    transform: scaleX(1);
  }

  .nav__theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--muted);
    padding: var(--space-1);
    display: flex;
    align-items: center;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav__theme-toggle:hover {
    color: var(--fg);
  }

  .nav__mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-1);
    z-index: 110;
  }

  .nav__mobile-line {
    display: block;
    width: 24px;
    height: 1.5px;
    background: var(--fg);
    transition: transform var(--duration-normal) var(--ease-out),
                opacity var(--duration-normal) var(--ease-out);
  }

  .nav__mobile-toggle--open .nav__mobile-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav__mobile-toggle--open .nav__mobile-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ── Mobile Dropdown Menu ──────────────────────────────────── */
  .mobile-dropdown-backdrop {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 98;
    background: rgba(13, 13, 13, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .mobile-dropdown-backdrop--open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-dropdown {
    position: fixed;
    top: 64px;
    left: 0;
    right: 0;
    z-index: 99;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: transform var(--duration-fast) var(--ease-out),
                opacity var(--duration-fast) var(--ease-out);
  }

  .mobile-dropdown--open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-dropdown__inner {
    padding: var(--space-2) 0 var(--space-3);
  }

  .mobile-dropdown__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-dropdown__item {
    border-bottom: 1px solid var(--rule);
  }

  .mobile-dropdown__item:first-child {
    border-top: 1px solid var(--rule);
  }

  .mobile-dropdown__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) 0;
    color: var(--fg);
    transition: color var(--duration-fast) var(--ease-out),
                padding-left var(--duration-fast) var(--ease-out);
  }

  .mobile-dropdown__num {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-wider);
    color: var(--muted);
    min-width: 28px;
  }

  .mobile-dropdown__title {
    font-size: 1.15rem;
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    flex: 1;
    margin-left: var(--space-2);
  }

  .mobile-dropdown__arrow {
