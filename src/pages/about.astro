---
import Base from '../layouts/Base.astro';

const experience = [
  {
    role: 'Motion Graphics Designer / Video Editor',
    company: 'PT. Mata Terbuka Lebar (Eyes Wide Open Studio)',
    location: 'Palembang, Indonesia',
    period: 'Jul 2025 — Present',
  },
  {
    role: 'Motion Graphics & Marketing Specialist',
    company: 'ID Card Lampung',
    location: 'Lampung, Indonesia',
    period: 'Nov 2022 — Jun 2025',
  },
  {
    role: 'Junior Motion Graphics Designer',
    company: 'Tampia Group',
    location: 'Indonesia',
    period: 'Apr 2021 — Sep 2021',
  },
  {
    role: 'Motion Graphics Intern',
    company: 'National Design Center',
    location: 'Indonesia',
    period: 'Jul 2023 — Aug 2023',
  },
  {
    role: 'Motion Graphics Intern',
    company: 'PT. Petakumpet Creativerse',
    location: 'Indonesia',
    period: 'Apr 2023 — Jun 2023',
  },
  {
    role: 'Motion Graphics Intern',
    company: 'PT. Linggau Media Group',
    location: 'Indonesia',
    period: 'Jun 2019 — Sep 2019',
  },
];

const education = [
  {
    degree: 'Bachelor of Visual Communication Design',
    institution: 'Sumatera Institute of Technology (ITERA)',
    location: 'Lampung, Indonesia',
    period: '2020 — 2024',
    gpa: '3.78 / 4.00',
    specialization: 'Motion graphics, automation, and visual effects',
  },
];
---

<Base title="CV / Resume — Achmad Zaini" description="About Achmad Zaini — Motion Graphics Designer and Video Editor. View experience, education, skills, and download CV.">

  <!-- ═══ Page Header ═══ -->
  <section class="about section--large" id="about-hero">
    <div class="container">
      <div class="about__header">
        <span class="section-label">CV / Resume</span>
        <span class="about__meta">&copy; {new Date().getFullYear()}</span>
      </div>
      <hr class="rule reveal-line" />
    </div>
  </section>

  <!-- ═══ About Content ═══ -->
  <section class="about-content section" id="about-content">
    <div class="container">
      <div class="about__grid grid">
        <!-- Image Column -->
        <div class="about__image-col col-5 col-md-4">
          <div class="about__image-wrapper reveal">
            <div class="about__image-placeholder" aria-label="Portrait of Achmad Zaini">
              <img src="/img/my_photo.webp" alt="Portrait of Achmad Zaini" class="about__image" />
            </div>
          </div>
        </div>

        <!-- Content Column -->
        <div class="about__content-col col-7 col-md-8">
          <h1 class="about__statement reveal">
            I craft motion systems that make complex stories feel effortless.
          </h1>

          <div class="about__bio reveal">
            <p>
              Video Editor &amp; Motion Graphics Designer from Palembang, South Sumatra, Indonesia, 
              with 5 years of experience in video editing, animation, and workflow automation.
            </p>
            <p>
              I studied Visual Communication Design at Sumatera Institute of Technology (ITERA), 
              where I learned to solve visual problems with clear, practical systems. I focus on 
              creating templates and processes that save time while keeping quality high.
            </p>
            <p>
              I've completed over 90 explainer videos in a year, handled 20+ projects at once, 
              and even built e‑commerce platforms from the ground up. Whether it's character 
              animation, dynamic text, or AR projects, I bring both technical accuracy and 
              creative design to every job.
            </p>
          </div>

          <!-- Download CV Button -->
          <div class="about__download reveal">
            <a href="/assets/cv/Achmad-Zaini-CV.pdf" download class="about__download-btn" id="download-cv-btn">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 1v10M8 11l-3-3M8 11l3-3M2 14h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/>
              </svg>
              <span>Download PDF CV</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Experience ═══ -->
  <section class="cv-section section" id="cv-experience">
    <div class="container">
      <span class="section-label reveal">01 — Experience</span>
      <hr class="rule reveal-line" />

      <table class="cv-table reveal" id="experience-table">
        <thead>
          <tr>
            <th>Role</th>
            <th>Company</th>
            <th>Period</th>
          </tr>
        </thead>
        <tbody>
          {experience.map((exp) => (
            <tr>
              <td class="cv-table__role">{exp.role}</td>
              <td class="cv-table__company">
                {exp.company}
                <span class="cv-table__location">{exp.location}</span>
              </td>
              <td class="cv-table__period">{exp.period}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ═══ Education ═══ -->
  <section class="cv-section section" id="cv-education">
    <div class="container">
      <span class="section-label reveal">02 — Education</span>
      <hr class="rule reveal-line" />

      <table class="cv-table reveal" id="education-table">
        <thead>
          <tr>
            <th>Degree</th>
            <th>Institution</th>
            <th>Period</th>
          </tr>
        </thead>
        <tbody>
          {education.map((edu) => (
            <tr>
              <td class="cv-table__role">
                {edu.degree}
                <span class="cv-table__location">GPA: {edu.gpa}</span>
              </td>
              <td class="cv-table__company">
                {edu.institution}
                <span class="cv-table__location">{edu.location}</span>
              </td>
              <td class="cv-table__period">{edu.period}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ═══ Capabilities ═══ -->
  <section class="capabilities section" id="capabilities">
    <div class="container">
      <span class="section-label reveal">03 — Capabilities</span>
      <hr class="rule reveal-line" />

      <div class="capabilities__grid grid">
        <div class="capabilities__col col-6 col-md-4 reveal">
          <h3 class="capabilities__heading">Technical & Motion</h3>
          <p class="capabilities__list">
            Adobe After Effects (Expressions & Scripting), Premiere Pro, Blender 3D, 
            2D/3D Animation, Character Rigging, Kinetic Typography, SparkAR
          </p>
        </div>
        <div class="capabilities__col col-6 col-md-4 reveal">
          <h3 class="capabilities__heading">Development & Automation</h3>
          <p class="capabilities__list">
            AI-Assisted Web Development, Workflow Automation, Web Deployment, 
            After Effects Scripting & Expressions, Batch Processing Pipelines
          </p>
        </div>
        <div class="capabilities__col col-6 col-md-4 reveal">
          <h3 class="capabilities__heading">Digital Marketing</h3>
          <p class="capabilities__list">
            Social Media Management (Instagram), Local SEO, Google Business Profile, 
            Google Maps Marketing, Content Strategy
          </p>
        </div>
        <div class="capabilities__col col-6 col-md-4 reveal">
          <h3 class="capabilities__heading">Languages</h3>
          <p class="capabilities__list">
            Indonesian (Native), English (Fluent)
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Recognition ═══ -->
  <section class="achievements section" id="achievements">
    <div class="container">
      <span class="section-label reveal">04 — Recognition</span>
      <hr class="rule reveal-line" />

      <div class="achievements__list">
        <div class="achievements__item reveal">
          <span class="achievements__year">2023</span>
          <div class="achievements__content">
            <h3 class="achievements__title">Grant Recipient — P2MW</h3>
            <p class="achievements__desc">Secured national Ministry of Education funding as part of the core team to launch and market the ID Card Lampung business.</p>
          </div>
        </div>
        <hr class="rule" />
        <div class="achievements__item reveal">
          <span class="achievements__year">2023</span>
          <div class="achievements__content">
            <h3 class="achievements__title">1st Place — Design Competitions</h3>
            <p class="achievements__desc">World Earth Day (2023), Processed Fish Food (2023), and Indonesian Culture (2021).</p>
          </div>
        </div>
        <hr class="rule" />
        <div class="achievements__item reveal">
          <span class="achievements__year">2022</span>
          <div class="achievements__content">
            <h3 class="achievements__title">Indonesian Bank Scholarship</h3>
            <p class="achievements__desc">Selected among the top 50 students for academic excellence and leadership impact.</p>
          </div>
        </div>
        <hr class="rule" />
        <div class="achievements__item reveal">
          <span class="achievements__year">2021</span>
          <div class="achievements__content">
            <h3 class="achievements__title">Teaching Assistant — Motion Graphics</h3>
            <p class="achievements__desc">Instructed 70+ students in After Effects workflow principles at ITERA.</p>
          </div>
        </div>
        <hr class="rule" />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── About Hero ──────────────────────────────────────────── */
  .about {
    padding-top: calc(64px + var(--space-7));
    padding-bottom: var(--space-3);
  }

  .about__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .about__meta {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── About Content ───────────────────────────────────────── */
  .about-content {
    padding-top: var(--space-5);
  }

  .about__image-wrapper {
    position: sticky;
    top: calc(64px + var(--space-4));
  }

  .about__image-placeholder {
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--fg);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .about__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
    filter: grayscale(100%);
    transition: filter var(--duration-normal, 0.4s) var(--ease-out, ease);
  }

  .about__image-placeholder:hover .about__image {
    filter: grayscale(0%);
  }

  .about__image-initials {
    font-size: var(--fs-display);
    font-weight: var(--fw-black);
    color: var(--bg);
    letter-spacing: var(--tracking-tight);
    opacity: 0.15;
  }

  .about__statement {
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    line-height: var(--leading-snug);
    margin-bottom: var(--space-5);
    max-width: 560px;
  }

  .about__bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 520px;
  }

  .about__bio p {
    font-size: var(--fs-body);
    color: var(--muted);
    line-height: var(--leading-relaxed);
  }


  /* ── Download CV Button ──────────────────────────────────── */
  .about__download {
    margin-top: var(--space-4);
  }

  .about__download-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--fg);
    border: 1px solid var(--rule);
    padding: var(--space-2) var(--space-4);
    transition: border-color var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .about__download-btn:hover {
    border-color: var(--fg);
    background-color: var(--fg);
    color: var(--bg);
  }

  .about__download-btn svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* ── CV Table ────────────────────────────────────────────── */
  .cv-section .section-label {
    display: block;
    margin-bottom: var(--space-3);
  }

  .cv-table {
    margin-top: var(--space-5);
  }

  .cv-table__role {
    font-weight: var(--fw-bold);
    width: 35%;
  }

  .cv-table__company {
    width: 40%;
  }

  .cv-table__period {
    width: 25%;
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--muted);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-wide);
  }

  .cv-table__location {
    display: block;
    font-size: var(--fs-small);
    color: var(--muted);
    margin-top: 0.25em;
  }

  /* ── Capabilities ────────────────────────────────────────── */
  .capabilities .section-label {
    margin-bottom: var(--space-3);
    display: block;
  }

  .capabilities__grid {
    padding-top: var(--space-5);
    row-gap: var(--space-5);
  }

  .capabilities__heading {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    margin-bottom: var(--space-1);
    letter-spacing: var(--tracking-normal);
  }

  .capabilities__list {
    font-size: var(--fs-body);
    color: var(--muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Achievements ────────────────────────────────────────── */
  .achievements .section-label {
    margin-bottom: var(--space-3);
    display: block;
  }

  .achievements__list {
    padding-top: var(--space-5);
  }

  .achievements__item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-4);
    padding: var(--space-3) 0;
  }

  .achievements__year {
    font-size: var(--fs-h3);
    font-weight: var(--fw-black);
    color: var(--rule);
    line-height: var(--leading-snug);
  }

  .achievements__title {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    margin-bottom: var(--space-1);
    letter-spacing: var(--tracking-normal);
  }

  .achievements__desc {
    font-size: var(--fs-body);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    max-width: 560px;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .about__image-placeholder {
      aspect-ratio: 1 / 1;
    }

    .about__image-col {
      grid-column: span 4;
      margin-bottom: var(--space-4);
    }

    .about__content-col {
      grid-column: span 4;
    }

    .about__image-wrapper {
      position: static;
    }

    .about__detail {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .capabilities__col {
      grid-column: span 4;
    }

    .achievements__item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .cv-table {
      display: block;
    }

    .cv-table thead {
      display: none;
    }

    .cv-table tbody,
    .cv-table tr,
    .cv-table td {
      display: block;
      width: 100%;
    }

    .cv-table tr {
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--rule);
    }

    .cv-table td {
      border: none;
      padding: 0.25em 0;
    }

    .cv-table__role {
      width: 100%;
    }

    .cv-table__company {
      width: 100%;
    }

    .cv-table__period {
      width: 100%;
      text-align: left;
    }
  }
</style>
