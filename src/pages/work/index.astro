---
import Base from '../../layouts/Base.astro';
import projects from '../../data/projects.json';

const featured = projects.filter((p: any) => p.featured);
const standard = projects.filter((p: any) => !p.featured);
const allCategories = [...new Set(projects.flatMap((p: any) => p.category))];

// Group standard projects by year for Fluxum-style year markers
const years = [...new Set(projects.map((p: any) => p.year))].sort((a, b) => b - a);
---

<Base title="Work — Achmad Zaini" description="Selected work by Achmad Zaini. Motion graphics, video editing, 2D animation, and interactive experiences.">

  <!-- ═══ Oversized Page Title (Khazar reference) ═══ -->
  <div class="work-hero-title" aria-hidden="true">Work</div>

  <!-- ═══ Side Marquee (Khazar reference) ═══ -->
  <div class="side-marquee" aria-hidden="true">
    <div class="side-marquee__track">
      <span>Achmad Zaini · Achmad Zaini · Achmad Zaini · Achmad Zaini · Achmad Zaini · Achmad Zaini ·&nbsp;</span>
      <span>Achmad Zaini · Achmad Zaini · Achmad Zaini · Achmad Zaini · Achmad Zaini · Achmad Zaini ·&nbsp;</span>
    </div>
  </div>

  <!-- ═══ Page Header ═══ -->
  <section class="work-header">
    <div class="container">
      <div class="work-header__breadcrumb">
        <a href="/">Home</a> / <span>Work</span>
      </div>
      <div class="work-header__row">
        <div class="work-header__left">
          <h1 class="work-header__title">Work</h1>
          <p class="work-header__desc">
            Selected projects spanning motion graphics, video editing,
            2D animation rigging, and interactive experiences.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ Featured Projects — Khazar Card Grid ═══ -->
  <section class="featured-section">
    <div class="container">
      <span class="section-label">Featured Projects</span>
      <hr class="rule reveal-line" />

      <div class="featured-grid">
        {featured.map((project: any) => (
          <article class="event-card" id={`featured-${project.slug}`}>
            <a href={project.slug === 'social-media-content' ? '/gallery' : '#'} class="event-card__link" data-id={project.id}>
              <p class="event-card__desc">{project.description}</p>

              <div class="event-card__date-row">
                <span class="event-card__number">{project.id}</span>
                <div class="event-card__date-meta">
                  <span class="event-card__year">{project.year}</span>
                  <span class="event-card__role">{project.role}</span>
                </div>
              </div>

              <div class="event-card__thumb-strip">
                {project.preview ? (
                  <video
                    src={project.previewWebm || project.preview}
                    poster={project.poster}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                    class="work-thumbnail-video"
                  />
                ) : (
                  <img src={project.poster} alt={project.title} loading="lazy" />
                )}
              </div>

              <div class="event-card__footer">
                <div class="event-card__tags">
                  {project.category.map((cat: string) => (
                    <span class="tag">{cat}</span>
                  ))}
                </div>
                <span class="event-card__cta">More info <span class="arrow">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ All Projects — Fluxum Row Listing ═══ -->
  <section class="listing-section">
    <div class="container">
      <div class="listing-header">
        <span class="section-label">All Projects</span>
      </div>
      <hr class="rule reveal-line" />

      <div class="listing-filter" id="listing-filter">
        <div class="listing-filter__tabs">
          <button class="listing-filter__tab listing-filter__tab--active" data-filter="all">All</button>
          {allCategories.map((cat) => (
            <button class="listing-filter__tab" data-filter={cat}>{cat}</button>
          ))}
        </div>
        <span class="listing-filter__count" id="project-count">{projects.length} projects</span>
      </div>

      <div class="listing-rows" id="listing-rows">
        {projects.map((project: any, idx: number) => (
          <article
            class="listing-row"
            data-categories={JSON.stringify(project.category)}
            data-year={project.year}
            id={`row-${project.slug}`}
          >
            <a href={project.slug === 'social-media-content' ? '/gallery' : '#'} class="listing-row__link" data-id={project.id}>
              <!-- Col 1: Thumbnail -->
              <div class="listing-row__thumb">
                {project.preview ? (
                  <video
                    src={project.previewWebm || project.preview}
                    poster={project.poster}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                    class="work-thumbnail-video"
                  />
                ) : (
                  <img src={project.poster} alt={project.title} loading="lazy" />
                )}
              </div>

              <!-- Col 2: Index + Date -->
              <div class="listing-row__date">
                <span class="listing-row__index">{project.id}</span>
                <span class="listing-row__year">{project.year}</span>
              </div>

              <!-- Col 3: Title + Tags -->
              <div class="listing-row__content">
                <h3 class="listing-row__title">{project.title}</h3>
                <div class="listing-row__tags">
                  {project.category.map((cat: string) => (
                    <span class="tag">{cat}</span>
                  ))}
                </div>
                <span class="listing-row__client">{project.client}</span>
              </div>

              <!-- Col 4: Description -->
              <p class="listing-row__desc">{project.description}</p>
            </a>
            <hr class="rule" />
          </article>
        ))}
      </div>

  <!-- ═══ Work Lightbox Modal ═══ -->
  <div class="work-modal" id="work-modal" aria-hidden="true">
    <div class="work-modal__backdrop" id="wm-backdrop"></div>
    <button class="work-modal__close" id="wm-close" aria-label="Close modal">&times;</button>
    
    <div class="work-modal__container">
      <!-- Pinned Media (top portion 55vh, or 16:9 box) -->
      <div class="work-modal__media-container" id="wm-media-container">
        <div class="work-modal__media" id="wm-media"></div>
      </div>
      
      <!-- Scrollable Details (bottom portion) -->
      <div class="work-modal__details" id="wm-details">
        <div class="work-modal__details-top">
          <div class="work-modal__header">
            <span class="work-modal__index" id="wm-index">01</span>
            <h2 class="work-modal__title" id="wm-title">Project Title</h2>
          </div>
          
          <div class="work-modal__meta-grid">
            <div class="meta-item">
              <span class="meta-label">Client</span>
              <span class="meta-val" id="wm-client">Client Name</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Role</span>
              <span class="meta-val" id="wm-role">Role</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Year</span>
              <span class="meta-val" id="wm-year">2024</span>
            </div>
          </div>
        </div>
        
        <hr class="rule" />
        
        <div class="work-modal__body">
          <p id="wm-desc">Project description goes here.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ Redirect Modal ═══ -->
  <div class="redirect-modal" id="redirect-modal" aria-hidden="true">
    <div class="redirect-modal__backdrop" id="rm-backdrop"></div>
    <div class="redirect-modal__container">
      <h3 class="redirect-modal__title">External Link</h3>
      <p class="redirect-modal__text">You will be redirected to this website:</p>
      <div class="redirect-modal__link-box">
        <span id="rm-desc"></span>
      </div>
      <div class="redirect-modal__actions">
        <button class="redirect-modal__btn" id="rm-cancel">Cancel</button>
        <a href="#" class="redirect-modal__btn redirect-modal__btn--primary" id="rm-go" target="_blank" rel="noopener noreferrer">Go</a>
      </div>
    </div>
  </div>

  <div id="projects-data" data-projects={JSON.stringify(projects)} style="display: none;"></div>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // ── Filter logic ──────────────────────────────────
    const tabs = document.querySelectorAll<HTMLButtonElement>('.listing-filter__tab');
    const rows = document.querySelectorAll<HTMLElement>('.listing-row');
    const countEl = document.getElementById('project-count');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('listing-filter__tab--active'));
        tab.classList.add('listing-filter__tab--active');
        const filter = tab.dataset.filter;
        let visible = 0;

        rows.forEach((row, i) => {
          const cats: string[] = JSON.parse(row.dataset.categories || '[]');
          const show = filter === 'all' || cats.includes(filter || '');
          if (show) {
            row.style.display = '';
            visible++;
            gsap.fromTo(row, { opacity: 0, y: 14 }, {
              opacity: 1, y: 0, duration: 0.4,
              ease: 'power3.out', delay: visible * 0.04
            });
          } else {
            gsap.to(row, {
              opacity: 0, duration: 0.2, ease: 'power2.in',
              onComplete: () => { row.style.display = 'none'; }
            });
          }
        });

        if (countEl) {
          const n = filter === 'all' ? rows.length : visible;
          countEl.textContent = `${n} project${n !== 1 ? 's' : ''}`;
        }
      });
    });

    // ── Stagger entrance: featured cards ──────────────
    const cards = gsap.utils.toArray<HTMLElement>('.event-card');
    if (cards.length) {
      gsap.from(cards, {
        opacity: 0, y: 30, duration: 0.6, stagger: 0.1,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.featured-grid', start: 'top 85%', once: true }
      });
    }

    // ── Stagger entrance: listing rows ────────────────
    const listRows = gsap.utils.toArray<HTMLElement>('.listing-row');
    if (listRows.length) {
      gsap.from(listRows, {
        opacity: 0, y: 20, duration: 0.5, stagger: 0.06,
        ease: 'power3.out',
        scrollTrigger: { trigger: '#listing-rows', start: 'top 85%', once: true }
      });
    }

    // ── Hover: listing rows ───────────────────────────
    rows.forEach(row => {
      row.addEventListener('mouseenter', () => {
        gsap.to(row.querySelector('.listing-row__thumb img, .listing-row__thumb video'), {
          scale: 1.06, duration: 0.5, ease: 'power2.out'
        });
      });
      row.addEventListener('mouseleave', () => {
        gsap.to(row.querySelector('.listing-row__thumb img, .listing-row__thumb video'), {
          scale: 1, duration: 0.4, ease: 'power2.inOut'
        });
      });
    });

    // ── Hover: featured cards ─────────────────────────
    cards.forEach(card => {
      const img = card.querySelector('.event-card__thumb-strip img, .event-card__thumb-strip video');
      const arrow = card.querySelector('.arrow');
      card.addEventListener('mouseenter', () => {
        if (img) gsap.to(img, { scale: 1.04, duration: 0.5, ease: 'power2.out' });
        if (arrow) gsap.to(arrow, { x: 4, duration: 0.3, ease: 'power2.out' });
      });
      card.addEventListener('mouseleave', () => {
        if (img) gsap.to(img, { scale: 1, duration: 0.4, ease: 'power2.inOut' });
        if (arrow) gsap.to(arrow, { x: 0, duration: 0.3, ease: 'power2.inOut' });
      });
    });

    // ── Fullscreen Lightbox Modal ──────────────────────
    const workModal = document.getElementById('work-modal')!;
    const wmBackdrop = document.getElementById('wm-backdrop')!;
    const wmClose = document.getElementById('wm-close')!;
    const wmMedia = document.getElementById('wm-media')!;
    const wmIndex = document.getElementById('wm-index')!;
    const wmTitle = document.getElementById('wm-title')!;
    const wmClient = document.getElementById('wm-client')!;
    const wmRole = document.getElementById('wm-role')!;
    const wmYear = document.getElementById('wm-year')!;
    const wmDesc = document.getElementById('wm-desc')!;

    const projectsList = JSON.parse(document.getElementById('projects-data')?.dataset.projects || '[]');

    function openProjectModal(projectId: string) {
      const project = projectsList.find((p: any) => p.id === projectId);
      if (!project) return;

      // Populate media
      wmMedia.innerHTML = '';
      if (project.preview) {
        const video = document.createElement('video');
        video.src = project.previewWebm || project.preview;
        video.poster = project.poster;
        video.autoplay = true;
        video.loop = true;
        video.controls = true;
        video.setAttribute('controlsList', 'nodownload');
        video.playsInline = true;
        wmMedia.appendChild(video);
      } else {
        const img = document.createElement('img');
        img.src = project.poster;
        img.alt = project.title;
        wmMedia.appendChild(img);
      }

      // Populate details
      wmIndex.textContent = project.id;
      wmTitle.textContent = project.title;
      wmClient.textContent = project.client;
      wmRole.textContent = project.role;
      wmYear.textContent = project.year.toString();
      wmDesc.textContent = project.description;

      // Activate Modal
      workModal.classList.add('work-modal--active');
      workModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeProjectModal() {
      workModal.classList.remove('work-modal--active');
      workModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      wmMedia.innerHTML = '';
    }

    // ── Redirect Modal ──────────────────────────────────
    const redirectModal = document.getElementById('redirect-modal')!;
    const rmBackdrop = document.getElementById('rm-backdrop')!;
    const rmCancel = document.getElementById('rm-cancel')!;
    const rmGo = document.getElementById('rm-go') as HTMLAnchorElement;
    const rmDesc = document.getElementById('rm-desc')!;

    function openRedirectModal(url: string, desc: string) {
      rmGo.href = url;
      rmDesc.textContent = desc;
      redirectModal.setAttribute('aria-hidden', 'false');
      redirectModal.classList.add('redirect-modal--active');
    }

    function closeRedirectModal() {
      redirectModal.setAttribute('aria-hidden', 'true');
      redirectModal.classList.remove('redirect-modal--active');
    }

    rmBackdrop.addEventListener('click', closeRedirectModal);
    rmCancel.addEventListener('click', closeRedirectModal);
    rmGo.addEventListener('click', closeRedirectModal);

    // Bind event listeners to card & list row links
    document.querySelectorAll<HTMLAnchorElement>('[data-id]').forEach(link => {
      link.addEventListener('click', (e) => {
        const projectId = link.dataset.id;
        const href = link.getAttribute('href');
        
        if (href && href.startsWith('/gallery')) return;
        
        e.preventDefault();
        
        if (projectId === '07') {
          openRedirectModal('https://idcardlampung.com', 'idcardlampung.com — E-Commerce platform for ID Card Lampung');
          return;
        }
        if (projectId === '06') {
          openRedirectModal('https://github.com/azaynzxz/after-effects-expression-panel', 'GitHub Repository — Automated Design Workflow System (After Effects Expression Panel)');
          return;
        }

        if (projectId) openProjectModal(projectId);
      });
    });

    wmClose.addEventListener('click', closeProjectModal);
    wmBackdrop.addEventListener('click', closeProjectModal);

    // Keyboard ESC to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && workModal.classList.contains('work-modal--active')) {
        closeProjectModal();
      }
    });
  </script>
</Base>

<style>
  /* ══════════════════════════════════════════════════════════════
     WORK PAGE — Khazar Card Grid + Fluxum Row Listing
     Swiss Rationalist · Editorial Layout
     ══════════════════════════════════════════════════════════════ */

  /* ── Fullscreen Lightbox Modal ────────────────────── */
  .work-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
  }

  .work-modal--active {
    pointer-events: all;
    opacity: 1;
  }

  .work-modal__backdrop {
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: 0.98;
  }

  .work-modal__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    background: none;
    border: none;
    color: var(--fg);
    font-size: 36px;
    cursor: pointer;
    z-index: 10000;
    line-height: 1;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .work-modal__close:hover {
    opacity: 1;
  }

  .work-modal__container {
    position: relative;
    z-index: 5;
    width: 90vw;
    max-width: 1200px;
    height: auto;
    max-height: 90vh;
    background: var(--bg);
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .work-modal__media-container {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    background: #000;
    border-bottom: 1px solid var(--rule);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .work-modal__media {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .work-modal__media :global(video),
  .work-modal__media :global(img) {
    width: 100%;
    height: 100%;
    max-height: calc(90vh - 120px);
    object-fit: contain;
    display: block;
  }

  .work-modal__details {
    padding: var(--space-3) var(--space-4);
    overflow-y: auto;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .work-modal__details-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .work-modal__header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
  }

  .work-modal__index {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: var(--fw-black);
    line-height: 0.85;
    color: var(--fg);
  }

  .work-modal__title {
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    margin: 0;
    line-height: 1;
    color: var(--fg);
  }

  .work-modal__meta-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .meta-label {
    font-size: 10px;
    text-transform: uppercase;
    color: var(--muted);
    letter-spacing: var(--tracking-wide);
  }

  .meta-val {
    font-size: 13px;
    font-weight: var(--fw-medium);
    color: var(--fg);
  }



  .work-modal__body {
    font-size: 14px;
    line-height: var(--leading-relaxed);
    color: var(--muted);
  }

  .work-thumbnail-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .work-modal__container {
      width: 95vw;
      height: 95vh;
      grid-template-rows: 45% 55%;
    }

    .work-modal__stats {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }

  /* ── Oversized decorative title (Khazar) ────────────────────── */
  .work-hero-title {
    position: fixed;
    top: 8%;
    right: -6vw;
    font-size: clamp(8rem, 18vw, 22rem);
    font-weight: var(--fw-black);
    font-style: italic;
    letter-spacing: -0.04em;
    color: var(--fg);
    opacity: 0.045;
    line-height: 0.82;
    pointer-events: none;
    z-index: 1;
    user-select: none;
  }

  /* ── Side Marquee (Khazar right edge) ───────────────────────── */
  .side-marquee {
    position: fixed;
    right: 16px;
    top: 0;
    height: 100vh;
    width: 14px;
    writing-mode: vertical-rl;
    font-size: 9px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    overflow: hidden;
    pointer-events: none;
    z-index: 10;
    opacity: 0.45;
  }

  .side-marquee__track {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
    animation: marquee-v 30s linear infinite;
  }

  .side-marquee__track span {
    display: block;
  }

  @keyframes marquee-v {
    from { transform: translateY(0); }
    to   { transform: translateY(-50%); }
  }

  /* ── Page Header ────────────────────────────────────────────── */
  .work-header {
    padding-top: calc(64px + var(--space-6));
    padding-bottom: var(--space-5);
  }

  .work-header__breadcrumb {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-wide);
    color: var(--muted);
    margin-bottom: var(--space-5);
  }

  .work-header__breadcrumb a {
    color: var(--muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .work-header__breadcrumb a:hover {
    color: var(--fg);
  }

  .work-header__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .work-header__left {
    max-width: 560px;
  }

  .work-header__title {
    font-size: var(--fs-h1);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-2);
  }

  .work-header__desc {
    font-size: var(--fs-body);
    color: var(--muted);
    line-height: var(--leading-relaxed);
  }

  /* ══════════════════════════════════════════════════════════════
     FEATURED — Khazar-style Event Card Grid
     ══════════════════════════════════════════════════════════════ */

  .featured-section {
    padding-bottom: var(--space-8);
  }

  .featured-section .section-label {
    display: block;
    margin-bottom: var(--space-3);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    padding-top: var(--space-5);
  }

  /* ── Event Card (Khazar) ────────────────────────────────────── */
  .event-card {
    border: 1px solid var(--rule);
    border-right: none;
    position: relative;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .event-card:last-child {
    border-right: 1px solid var(--rule);
  }

  .event-card:hover {
    background-color: rgba(0, 0, 0, 0.015);
  }

  [data-theme="dark"] .event-card:hover {
    background-color: rgba(255, 255, 255, 0.03);
  }

  .event-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .event-card__desc {
    font-size: 13px;
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
