---
import Base from '../../layouts/Base.astro';
import projects from '../../data/projects.json';

// 01 / Video Editing featured projects (explainer-2d-animations, baraca-capital-interview, eyes-wide-open)
const videoSlugs = ['explainer-2d-animations', 'baraca-capital-interview', 'eyes-wide-open'];
const featuredVideos = videoSlugs.map(slug => projects.find((p: any) => p.slug === slug)).filter(Boolean);

// 02 / Graphic Design featured brandbooks (Place Branding GKU 2, Brandbook PDIN, Brand Book IMB Group)
const graphicDesignSlugs = ['gku-2-twin-building', 'pdin-yogyakarta', 'imb-group-makassar'];
const featuredGraphicDesign = graphicDesignSlugs.map(slug => projects.find((p: any) => p.slug === slug)).filter(Boolean);

const categories = ['Motion', 'Graphic Design', 'Scripts'];

// Helper to determine destination href
const getProjectHref = (project: any) => {
  if (project.flipbookUrl) return project.flipbookUrl;
  if (project.slug === 'social-media-content') return '/gallery';
  if (project.id === '06') return 'https://idcardlampung.com';
  if (project.id === '12') return 'https://github.com/azaynzxz/after-effects-expression-panel';
  return `/work/${project.slug}`;
};
import '../../styles/pages/work.css';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { Image } from 'astro:assets';

// Import local assets for Astro Image optimization
const assets = import.meta.glob<{ default: ImageMetadata | string }>('/src/assets/work/**/*.{jpeg,jpg,png,gif,webp}', { eager: true });

function getAsset(path: string) {
  if (!path) return null;
  const key = `/src${path}`;
  return assets[key] ? assets[key].default : null;
}
---

<Base title="Selected Work & Case Studies — Achmad Zaini" description="Commercial motion design systems, brand guidelines, and automated production pipelines by Achmad Zaini.">

  <Fragment slot="head">
    <link rel="prefetch" href="/vendor/turnjs/jquery.min.js" as="script" />
    <link rel="prefetch" href="/vendor/turnjs/turn.min.js" as="script" />
  </Fragment>

  <!-- ═══ Page Header ═══ -->
  <section class="work-header">
    <div class="container">
      <div class="work-header__breadcrumb">
        <a href="/">Home</a> / <span>Selected Work</span>
      </div>
    </div>
  </section>

  <!-- ═══ Big Display Title (Gallery-style) ═══ -->
  <section class="work-title-section">
    <div class="container">
      <div class="work-title-clip">
        <h1 class="work-big-title">Work</h1>
      </div>
      <p class="work-lead reveal">
        Commercial motion design systems, comprehensive brand identity guidelines, and automated production pipelines built for studios, agencies, and global brands.
      </p>
    </div>
  </section>

  <!-- ═══ 01 / Video Editing ═══ -->
  <section class="featured-section">
    <div class="container">
      <span class="section-label">01 / Video Editing</span>
      <hr class="rule reveal-line" />

      <div class="featured-grid">
        {featuredVideos.map((project: any) => (
          <article class="event-card" id={`featured-${project.slug}`}>
            <a href={getProjectHref(project)} class="event-card__link" data-id={project.id}>
              <h3 class="event-card__title">{project.title}</h3>

              <div class="event-card__thumb-strip">
                {project.preview ? (
                  <video
                    src={`${project.previewWebm || project.preview}#t=0.001`}
                    poster={project.poster || ''}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                    class="work-thumbnail-video"
                  />
                ) : (
                  getAsset(project.poster) ? (
                    <Image
                      src={getAsset(project.poster) as ImageMetadata}
                      alt={project.title}
                      width={400}
                      height={225}
                      quality={80}
                      loading="eager"
                    />
                  ) : (
                    <img src={project.poster} alt={project.title} width="400" height="225" loading="eager" />
                  )
                )}
              </div>

              <div class="event-card__footer">
                <div class="event-card__tags">
                  {project.category.map((cat: string) => (
                    <span class="tag">{cat}</span>
                  ))}
                </div>
                <span class="event-card__cta">
                  {project.flipbookUrl ? 'Read brandbook' : 'View case'} <span class="arrow">&rarr;</span>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 02 / Graphic Design ═══ -->
  <section class="featured-section" style="padding-top: var(--space-6);">
    <div class="container">
      <span class="section-label">02 / Graphic Design</span>
      <hr class="rule reveal-line" />

      <div class="featured-grid">
        {featuredGraphicDesign.map((project: any) => (
          <article class="event-card" id={`featured-${project.slug}`}>
            <a href={getProjectHref(project)} class="event-card__link" data-id={project.id}>
              <h3 class="event-card__title">{project.title}</h3>

              <div class="event-card__thumb-strip">
                {project.preview ? (
                  <video
                    src={`${project.previewWebm || project.preview}#t=0.001`}
                    poster={project.poster || ''}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                    class="work-thumbnail-video"
                  />
                ) : (
                  getAsset(project.poster) ? (
                    <Image
                      src={getAsset(project.poster) as ImageMetadata}
                      alt={project.title}
                      width={400}
                      height={225}
                      quality={80}
                      loading="eager"
                    />
                  ) : (
                    <img src={project.poster} alt={project.title} width="400" height="225" loading="eager" />
                  )
                )}
              </div>

              <div class="event-card__footer">
                <div class="event-card__tags">
                  {project.category.map((cat: string) => (
                    <span class="tag">{cat}</span>
                  ))}
                </div>
                <span class="event-card__cta">
                  {project.flipbookUrl ? 'Read brandbook' : 'View case'} <span class="arrow">&rarr;</span>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ All Projects — Fluxum Row Listing ═══ -->
  <section class="listing-section">
    <div class="container">
      <div class="listing-header">
        <span class="section-label">03 / Complete Production Archive</span>
      </div>
      <hr class="rule reveal-line" />

      <div class="listing-filter" id="listing-filter">
        <div class="listing-filter__tabs">
          <button class="listing-filter__tab listing-filter__tab--active" data-filter="all">All</button>
          {categories.map((cat) => (
            <button class="listing-filter__tab" data-filter={cat}>{cat}</button>
          ))}
        </div>
        <span class="listing-filter__count" id="project-count">{projects.length} projects</span>
      </div>

      <div class="listing-rows" id="listing-rows">
        {projects.map((project: any, idx: number) => (
          <article
            class="listing-row"
            data-categories={JSON.stringify(project.category)}
            data-year={project.year}
            id={`row-${project.slug}`}
          >
            <a href={getProjectHref(project)} class="listing-row__link" data-id={project.id}>
              <!-- Col 1: Thumbnail -->
              <div class="listing-row__thumb">
                {project.preview ? (
                  <video
                    src={`${project.previewWebm || project.preview}#t=0.001`}
                    poster={project.poster || ''}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                    class="work-thumbnail-video"
                  />
                ) : (
                  getAsset(project.poster) ? (
                    <Image
                      src={getAsset(project.poster) as ImageMetadata}
                      alt={project.title}
                      width={96}
                      height={54}
                      quality={75}
                      loading={idx < 4 ? 'eager' : 'lazy'}
                    />
                  ) : (
                    <img src={project.poster} alt={project.title} width="96" height="54" loading={idx < 4 ? 'eager' : 'lazy'} />
                  )
                )}
              </div>

              <!-- Col 2: Index + Date -->
              <div class="listing-row__date">
                <span class="listing-row__index" data-original-index={String(idx + 1).padStart(2, '0')}>{String(idx + 1).padStart(2, '0')}</span>
                <span class="listing-row__year">{project.year}</span>
              </div>

              <!-- Col 3: Title + Tags -->
              <div class="listing-row__content">
                <h3 class="listing-row__title">{project.title}</h3>
                <div class="listing-row__tags">
                  {project.category.map((cat: string) => (
                    <span class="tag">{cat}</span>
                  ))}
                </div>
                <span class="listing-row__client">{project.client}</span>
              </div>

              <!-- Col 4: Description -->
              <p class="listing-row__desc">{project.description}</p>
            </a>
            <hr class="rule" />
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ Work Lightbox Modal ═══ -->
  <div class="work-modal" id="work-modal" aria-hidden="true">
    <div class="work-modal__backdrop" id="wm-backdrop"></div>
    <button class="work-modal__close" id="wm-close" aria-label="Close modal">&times;</button>
    
    <div class="work-modal__container">
      <!-- Pinned Media (top portion 55vh, or 16:9 box) -->
      <div class="work-modal__media-container" id="wm-media-container">
        <div class="work-modal__media" id="wm-media">
          <div id="wm-custom-player-wrapper" style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center;">
            <VideoPlayer src="" id="wm-custom-player" />
          </div>
          <img id="wm-custom-img" src="" alt="" style="display: none; width: 100%; height: 100%; object-fit: contain;" />
        </div>
      </div>
      
      <!-- Scrollable Details (bottom portion) -->
      <div class="work-modal__details" id="wm-details">
        <div class="work-modal__details-top">
          <div class="work-modal__header">
            <span class="work-modal__index" id="wm-index">01</span>
            <h2 class="work-modal__title" id="wm-title">Project Title</h2>
          </div>
          
          <div class="work-modal__meta-grid">
            <div class="meta-item">
              <span class="meta-label">Client</span>
              <span class="meta-val" id="wm-client">Client Name</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Role</span>
              <span class="meta-val" id="wm-role">Role</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Year</span>
              <span class="meta-val" id="wm-year">2024</span>
            </div>
          </div>
        </div>
        
        <hr class="rule" />
        
        <div class="work-modal__body">
          <p id="wm-desc">Project description goes here.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ Redirect Modal ═══ -->
  <div class="redirect-modal" id="redirect-modal" aria-hidden="true">
    <div class="redirect-modal__backdrop" id="rm-backdrop"></div>
    <div class="redirect-modal__container">
      <h3 class="redirect-modal__title">External Link</h3>
      <p class="redirect-modal__text">You will be redirected to this website:</p>
      <div class="redirect-modal__link-box">
        <span id="rm-desc"></span>
      </div>
      <div class="redirect-modal__actions">
        <button class="redirect-modal__btn" id="rm-cancel">Cancel</button>
        <a href="about:blank" class="redirect-modal__btn redirect-modal__btn--primary" id="rm-go" target="_blank" rel="noopener noreferrer">Go</a>
      </div>
    </div>
  </div>

  <div id="projects-data" data-projects={JSON.stringify(projects)} style="display: none;"></div>

<script src="../../scripts/pages/work.ts"></script>
</Base>

