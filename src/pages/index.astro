---
import Base from '../layouts/Base.astro';
import projects from '../data/projects.json';

const featured = projects.filter((p: any) => p.featured);
---

<Base title="Achmad Zaini — Motion Graphics Designer & Video Editor">
  <!-- ═══ Hero Section ═══ -->
  <section class="hero section--large" id="hero">
    <div class="container">
      <div class="hero__top">
        <span class="section-label">Portfolio — 2025</span>
        <span class="hero__meta">&copy; {new Date().getFullYear()}</span>
      </div>
      <hr class="rule reveal-line" />
      <div class="hero__content">
        <h1 class="hero__title">Achmad Zaini</h1>
        <p class="hero__subtitle">
          Motion Graphics Designer<br />&amp; Video Editor
        </p>
      </div>
      <div class="hero__bottom">
        <p class="hero__tagline reveal">
          Five years crafting high-retention video content,<br />
          2D animation systems, and automated workflows.
        </p>
        <span class="hero__location reveal">Palembang, Indonesia</span>
      </div>
    </div>
  </section>

  <!-- ═══ Featured Work — Sneak Peek (Khazar cards) ═══ -->
  <section class="peek section" id="work-peek">
    <div class="container">
      <div class="peek__header">
        <span class="section-label">01 — Selected Work</span>
      </div>
      <hr class="rule reveal-line" />

      <div class="peek__grid">
        {featured.map((project: any) => (
          <article class="peek-card" id={`peek-${project.slug}`}>
            <a href="/work" class="peek-card__link">
              <p class="peek-card__desc">{project.description}</p>

              <div class="peek-card__date-row">
                <span class="peek-card__number">{project.id}</span>
                <div class="peek-card__date-meta">
                  <span class="peek-card__year">{project.year}</span>
                  <span class="peek-card__role">{project.role}</span>
                </div>
              </div>

              <div class="peek-card__thumb">
                {project.preview ? (
                  <video
                    src={project.previewWebm || project.preview}
                    poster={project.poster}
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="auto"
                  />
                ) : (
                  <img src={project.poster} alt={project.title} loading="lazy" />
                )}
              </div>

              <div class="peek-card__footer">
                <div class="peek-card__tags">
                  {project.category.map((cat: string) => (
                    <span class="tag">{cat}</span>
                  ))}
                </div>
                <span class="peek-card__cta">More info <span class="arrow">→</span></span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <!-- View All CTA -->
      <div class="peek__cta">
        <a href="/work" class="peek__cta-btn">
          <span>View all projects</span>
          <span class="peek__cta-count">{projects.length}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ Process Section ═══ -->
  <section class="process section" id="process">
    <div class="container">
      <div class="process__header reveal">
        <span class="section-label">02 — Process</span>
      </div>
      <hr class="rule reveal-line" />
      <div class="process__grid grid">
        <div class="process__item col-4 col-md-4 reveal">
          <span class="process__number">01</span>
          <h3 class="process__title">Concept & Script</h3>
          <p class="process__desc">Collaborate with clients and scriptwriters to define visual direction, pacing, and narrative structure.</p>
        </div>
        <div class="process__item col-4 col-md-4 reveal">
          <span class="process__number">02</span>
          <h3 class="process__title">Design & Animate</h3>
          <p class="process__desc">Build motion systems using After Effects expressions, 2D character rigging, and kinetic typography.</p>
        </div>
        <div class="process__item col-4 col-md-4 reveal">
          <span class="process__number">03</span>
          <h3 class="process__title">Deliver & Optimize</h3>
          <p class="process__desc">Finalize with SFX, color grading, and format optimization for platform-specific requirements.</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ══════════════════════════════════════════════════════════════
     HOMEPAGE — Hero + Featured Peek + Process
     ══════════════════════════════════════════════════════════════ */

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: calc(64px + var(--space-8));
    padding-bottom: var(--space-7);
  }

  .hero .container {
    width: 100%;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .hero__meta {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__content {
    padding: var(--space-6) 0;
  }

  .hero__title {
    font-size: var(--fs-display);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-tight);
    line-height: 0.95;
    text-transform: uppercase;
    overflow: hidden;
  }

  :global(.hero__word) {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }

  :global(.hero__word-inner) {
    display: inline-block;
  }

  .hero__subtitle {
    font-size: var(--fs-h2);
    font-weight: var(--fw-regular);
    color: var(--muted);
    margin-top: var(--space-3);
    line-height: var(--leading-snug);
  }

  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: var(--space-5);
  }

  .hero__tagline {
    font-size: var(--fs-body);
    color: var(--muted);
    line-height: var(--leading-relaxed);
    max-width: 480px;
  }

  .hero__location {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ══════════════════════════════════════════════════════════════
     FEATURED PEEK — Khazar Card Grid (sneak peek from /work)
     ══════════════════════════════════════════════════════════════ */

  .peek {
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }

  .peek__header {
    margin-bottom: var(--space-3);
  }

  .peek__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    padding-top: var(--space-5);
  }

  /* ── Peek Card (Khazar style) ───────────────────────────────── */
  .peek-card {
    border: 1px solid var(--rule);
    border-right: none;
    position: relative;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .peek-card:last-child {
    border-right: 1px solid var(--rule);
  }

  .peek-card:hover {
    background-color: rgba(0, 0, 0, 0.015);
  }

  [data-theme="dark"] .peek-card:hover {
    background-color: rgba(255, 255, 255, 0.03);
  }

  .peek-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .peek-card__desc {
    font-size: 13px;
    color: var(--muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-shrink: 0;
  }

  .peek-card__date-row {
    display: flex;
    align-items: flex-end;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .peek-card__number {
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-tight);
    line-height: 0.85;
    color: var(--fg);
  }

  .peek-card__date-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding-bottom: 6px;
  }

  .peek-card__year {
    font-size: 13px;
    font-weight: var(--fw-bold);
    color: var(--fg);
    line-height: 1.2;
  }

  .peek-card__role {
    font-size: 11px;
    font-weight: var(--fw-regular);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    line-height: 1.2;
  }

  .peek-card__thumb {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    margin-bottom: var(--space-3);
    background: var(--rule);
  }

  .peek-card__thumb img,
  .peek-card__thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
    transition: none; /* GSAP handles it */
  }

  .peek-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
  }

  .peek-card__tags {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
  }

  .peek-card__tags .tag {
    font-size: 9px;
    padding: 0.15em 0.5em;
  }

  .peek-card__cta {
    font-size: 11px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--fg);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .peek-card__cta .arrow {
    display: inline-block;
    transition: none; /* GSAP handles it */
  }

  /* ── View All CTA ───────────────────────────────────────────── */
  .peek__cta {
    display: flex;
    justify-content: center;
    padding-top: var(--space-6);
  }

  .peek__cta-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--fg);
    border: 1px solid var(--rule);
    padding: var(--space-2) var(--space-5);
    transition: border-color var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .peek__cta-btn:hover {
    border-color: var(--fg);
    background-color: var(--fg);
    color: var(--bg);
  }

  .peek__cta-btn:hover .peek__cta-count {
    background-color: var(--bg);
    color: var(--fg);
  }

  .peek__cta-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    font-size: 10px;
    font-weight: var(--fw-bold);
    letter-spacing: 0;
    background: var(--fg);
    color: var(--bg);
    border-radius: 0;
    transition: background-color var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  /* ── Process ─────────────────────────────────────────────── */
  .process__header {
    margin-bottom: var(--space-3);
  }

  .process__grid {
    padding-top: var(--space-5);
  }

  .process__item {
    padding: var(--space-4) 0;
  }

  .process__number {
    font-size: var(--fs-display);
    font-weight: var(--fw-black);
    letter-spacing: var(--tracking-tight);
    color: var(--rule);
    line-height: 1;
    display: block;
    margin-bottom: var(--space-3);
  }

  .process__title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    margin-bottom: var(--space-2);
  }

  .process__desc {
    color: var(--muted);
    font-size: var(--fs-body);
    line-height: var(--leading-relaxed);
  }

  /* ══════════════════════════════════════════════════════════════
     RESPONSIVE
     ══════════════════════════════════════════════════════════════ */

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: calc(64px + var(--space-6));
    }

    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .peek__grid {
      grid-template-columns: 1fr 1fr;
    }

    .peek-card {
      border-right: 1px solid var(--rule);
    }

    .peek-card:nth-child(odd) {
      border-right: none;
    }

    .peek-card:last-child {
      grid-column: span 2;
      border-right: 1px solid var(--rule);
    }

    .peek-card__number {
      font-size: 2.5rem;
    }

    .process__item {
      grid-column: span 4;
    }
  }

  @media (max-width: 480px) {
    .peek__grid {
      grid-template-columns: 1fr;
    }

    .peek-card {
      border-right: 1px solid var(--rule) !important;
    }

    .peek-card:last-child {
      grid-column: span 1;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  // ── Hover: peek cards ───────────────────────────────────
  const peekCards = document.querySelectorAll<HTMLElement>('.peek-card');
  peekCards.forEach(card => {
    const img = card.querySelector<HTMLElement>('.peek-card__thumb img');
    const arrow = card.querySelector<HTMLElement>('.arrow');

    card.addEventListener('mouseenter', () => {
      if (img) gsap.to(img, { scale: 1.04, duration: 0.5, ease: 'power2.out' });
      if (arrow) gsap.to(arrow, { x: 4, duration: 0.3, ease: 'power2.out' });
    });

    card.addEventListener('mouseleave', () => {
      if (img) gsap.to(img, { scale: 1, duration: 0.4, ease: 'power2.inOut' });
      if (arrow) gsap.to(arrow, { x: 0, duration: 0.3, ease: 'power2.inOut' });
    });
  });

  // ── Stagger entrance for peek cards ─────────────────────
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const cards = gsap.utils.toArray<HTMLElement>('.peek-card');
  if (cards.length) {
    gsap.from(cards, {
      opacity: 0, y: 30, duration: 0.6, stagger: 0.1,
      ease: 'power3.out',
      scrollTrigger: { trigger: '.peek__grid', start: 'top 85%', once: true }
    });
  }
</script>
