---
import Base from '../../layouts/Base.astro';
import projects from '../../data/projects.json';
import gallery from '../../data/gallery.json';
import Testimonials from '../../components/Testimonials.astro';
import BookMockup from '../../components/BookMockup.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import { Image } from 'astro:assets';
import '../../styles/pages/work.css';
import '../../styles/pages/gallery.css';

// 01 / Brand Identity Guidelines (Brandbooks)
const brandbookSlugs = [
  'dr-koffie',
  'gku-2-twin-building',
  'pdin-yogyakarta',
  'id-card-lampung',
  'lombok-coconut-oil',
  'imb-group-makassar'
];

const brandbooks = brandbookSlugs
  .map(slug => projects.find((p: any) => p.slug === slug))
  .filter(Boolean);

// Local asset resolvers for gallery
const galleryAssets = import.meta.glob<{ default: ImageMetadata | string }>('/src/assets/gallery/*.{jpeg,jpg,png,gif,webp,mp4,webm}', { eager: true });

function getGalleryAsset(path: string) {
  if (!path) return null;
  const key = `/src${path}`;
  return galleryAssets[key] ? galleryAssets[key].default : null;
}

// 02 / Group gallery items by category
const allCategories = [...new Set(gallery.map((item: any) => item.category))];

const categorizedGallery = allCategories.map((cat) => ({
  name: cat,
  slug: cat.toLowerCase().replace(/[^a-z0-9]/g, '-'),
  items: gallery.filter((item: any) => item.category === cat)
}));
---

<Base 
  title="Graphic Design & Brand Systems — Achmad Zaini" 
  description="Brand identity guidelines, editorial systems, and scalable social marketing collateral by Achmad Zaini. Featuring interactive brandbook flipbooks and 59 design pieces."
>
  <Fragment slot="head">
    <link rel="prefetch" href="/vendor/turnjs/jquery.min.js" as="script" />
    <link rel="prefetch" href="/vendor/turnjs/turn.min.js" as="script" />
  </Fragment>

  <div id="graphic-design-hub">
    <!-- Breadcrumb -->
    <section class="work-header">
      <div class="container">
        <div class="work-header__breadcrumb">
          <a href="/">Home</a> / <span>Graphic Design</span>
        </div>
      </div>
    </section>

    <!-- Header Section with Realigned & Scaled Title -->
    <section class="graphic-title-section">
      <div class="container">
        <h1 class="graphic-design-title">Graphic Design</h1>
        <p class="graphic-lead reveal">
          Brand identity guidelines, editorial systems, and scalable social media marketing collateral. Systematic documentation engineered for strict print and digital consistency.
        </p>
      </div>
    </section>

    <!-- 01 / Brand Identity Guidelines (Interactive Flipbooks) -->
    <section class="featured-section" id="brand-guidelines">
      <div class="container">
        <div class="featured-header">
          <span class="section-label">01 / Brand Identity Guidelines</span>
          <span class="listing-filter__count">{brandbooks.length} Interactive Brandbooks</span>
        </div>
        <hr class="rule reveal-line" />

        <div class="brandbooks-grid">
          {brandbooks.map((project: any) => (
            <article class="event-card brandbook-card" id={`brandbook-${project.slug}`}>
              <a href={project.flipbookUrl || `/read/${project.slug}`} class="event-card__link" data-id={project.id}>
                <h3 class="event-card__title">{project.title}</h3>

                <div class="brandbook-mockup-container">
                  <BookMockup
                    cover={project.poster}
                    title={project.title}
                    pages={project.stats?.[0]?.value}
                  />
                </div>

                <div class="event-card__footer">
                  <div class="event-card__tags">
                    <span class="tag">Brandbook</span>
                    {project.stats && project.stats[0] && (
                      <span class="tag">{project.stats[0].value} {project.stats[0].unit}</span>
                    )}
                  </div>
                  <span class="event-card__cta">
                    Read brandbook <span class="arrow">&rarr;</span>
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 / Client Endorsements -->
    <Testimonials 
      category="graphic-design" 
      columns={3}
      sectionNumber="02" 
      title="Clients Testimonial" 
      subtitle="Feedback on brand architecture, print consistency, and marketing collateral." 
    />

    <!-- 03 / Social & Feed Systems + Posters -->
    <section class="gallery-header" id="social-and-posters" style="padding-top: var(--space-8);">
      <div class="container">
        <div class="gallery-header__top">
          <span class="section-label gallery-label">03 / Social & Feed Systems + Posters</span>
          <div class="gallery-header__right">
            <div class="gallery-nav" id="gallery-nav">
              {categorizedGallery.map((group) => (
                <a href={`#${group.slug}`} class="gallery-nav__tab">{group.name}</a>
              ))}
            </div>
            <span class="gallery-count">{gallery.length} pieces</span>
          </div>
        </div>
        <hr class="rule reveal-line" />
      </div>
    </section>

    <!-- Categorized Visual Grid Sections -->
    {categorizedGallery.map((group, groupIdx) => (
      <section class="gallery-grid-section" id={group.slug}>
        <div class="container">
          <div class="category-meta">
            <h2 class="category-title">{group.name}</h2>
            <span class="category-count">{group.items.length} pieces</span>
          </div>
          
          <div class="gallery-grid">
            {group.items.map((item: any, itemIdx: number) => (
              <article
                class="gallery-cell"
                data-category={item.category}
                data-id={item.id}
                id={`cell-${item.id}`}
              >
                <!-- Meta Block -->
                <div class="cell-meta">
                  <span class="cell-title">{item.title}</span>
                  <span class="cell-desc meta-muted">{item.description}</span>
                  <span class="cell-platform meta-muted">{item.platform} · {item.format.split(' · ')[1]} · {item.year}</span>
                </div>

                <hr class="cell-rule" />

                <!-- Image / Video Block -->
                <div class="cell-media">
                  {item.isAnimated && item.preview ? (
                    <video
                      src={`${item.previewWebm || item.preview}#t=0.001`}
                      poster={item.poster || ''}
                      preload="auto"
                      muted
                      loop
                      playsinline
                      class="cell-video"
                      data-hover-video
                    />
                  ) : (
                    getGalleryAsset(item.poster) ? (
                      <Image
                        src={getGalleryAsset(item.poster) as ImageMetadata}
                        alt={`${item.title} — ${item.client}`}
                        width={600}
                        quality={75}
                        loading={groupIdx === 0 && itemIdx < 8 ? 'eager' : 'lazy'}
                        decoding={groupIdx === 0 && itemIdx < 8 ? 'sync' : 'async'}
                        class="cell-img"
                      />
                    ) : (
                      <img
                        src={item.poster}
                        alt={`${item.title} — ${item.client}`}
                        loading={groupIdx === 0 && itemIdx < 8 ? 'eager' : 'lazy'}
                        decoding={groupIdx === 0 && itemIdx < 8 ? 'sync' : 'async'}
                        class="cell-img"
                      />
                    )
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- Fullscreen Lightbox -->
    <div class="lightbox" id="lightbox" aria-hidden="true">
      <div class="lightbox__backdrop" id="lb-backdrop"></div>
      <button class="lightbox__close" id="lb-close" aria-label="Close lightbox">&times;</button>
      <button class="lightbox__nav lightbox__nav--prev" id="lb-prev" aria-label="Previous">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M13 3L6 10L13 17" stroke-linecap="square" />
        </svg>
      </button>
      <div class="lightbox__content">
        <div class="lightbox__media" id="lb-media">
          <div id="lb-custom-player-wrapper" style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center;">
            <VideoPlayer src="" id="lb-custom-player" />
          </div>
          <img id="lb-custom-img" src="" alt="" style="display: none; max-width: 90vw; max-height: 80vh; object-fit: contain;" />
        </div>
        <div class="lightbox__caption" id="lb-caption"></div>
      </div>
      <button class="lightbox__nav lightbox__nav--next" id="lb-next" aria-label="Next">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M7 3L14 10L7 17" stroke-linecap="square" />
        </svg>
      </button>
    </div>
  </div>

  <style>
    /* ── Graphic Design Page Specific Styles ── */
    .graphic-title-section {
      padding-top: var(--space-4);
      padding-bottom: var(--space-8);
    }

    .graphic-design-title {
      font-family: var(--font-family);
      font-size: clamp(34px, 5.8vw, 76px);
      font-weight: 900;
      letter-spacing: -0.035em;
      line-height: 1;
      text-transform: uppercase;
      color: var(--fg);
      margin: 0 0 var(--space-3) 0;
      padding: 0;
      display: block;
      overflow-wrap: break-word;
      word-break: break-word;
    }

    .graphic-lead {
      font-size: clamp(14px, 1.25vw, 17px);
      line-height: 1.55;
      color: var(--fg-muted);
      max-width: 780px;
      margin: 0;
    }

    /* ── Brandbooks Grid Layout ── */
    .brandbooks-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }

    .brandbook-card {
      border: 1px solid var(--rule);
      background: var(--bg);
      display: flex;
      flex-direction: column;
      transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
    }

    .brandbook-card:hover {
      border-color: var(--fg-muted);
    }

    .brandbook-mockup-container {
      width: 100%;
      aspect-ratio: 16 / 10;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.02);
      border-top: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
      padding: 12px 14px;
      position: relative;
      overflow: hidden;
    }

    [data-theme="dark"] .brandbook-mockup-container {
      background: rgba(255, 255, 255, 0.02);
    }

    /* ── Responsive Grid ── */
    @media (max-width: 1024px) {
      .brandbooks-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-3);
      }
    }

    @media (max-width: 640px) {
      .graphic-title-section {
        padding-top: var(--space-2);
        padding-bottom: var(--space-6);
      }

      .graphic-design-title {
        font-size: clamp(30px, 9vw, 42px);
        line-height: 1.05;
      }

      .brandbooks-grid {
        grid-template-columns: 1fr;
        gap: var(--space-3);
      }
    }
  </style>

  <script src="../../scripts/pages/graphic-design.ts"></script>
</Base>
