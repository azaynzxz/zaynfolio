---
import Base from '../layouts/Base.astro';
import '../styles/pages/contact.css';
---

<Base title="Contact — Achmad Zaini" description="Get in touch with Achmad Zaini for motion graphics, video editing, and animation projects.">
  <section class="contact-hero section--large" id="contact-hero">
    <div class="container">
      <div class="contact__top">
        <span class="section-label">Contact</span>
        <span class="contact__meta">&copy; {new Date().getFullYear()}</span>
      </div>
      <hr class="rule reveal-line" />
    </div>
  </section>

  <section class="contact-content section" id="contact-content">
    <div class="container">
      <div class="contact__main">
        <p class="contact__lead reveal">
          Have a project in mind?<br />Let's work together.
        </p>

        <a href="mailto:contact.azaynz@gmail.com" class="contact__email reveal" id="contact-email">
          contact.azaynz@gmail.com
        </a>

        <a href="tel:+6281343790990" class="contact__phone reveal">
          +62 813 4379 0990
        </a>
      </div>

      <hr class="rule reveal-line" />

      <div class="contact__grid grid">
        <div class="contact__col col-4 col-md-4 reveal">
          <h3 class="contact__heading">Social</h3>
          <div class="contact__links">
            <a href="https://linkedin.com/in/achmadzaini" class="contact__link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://behance.net/achmadzaini" class="contact__link" target="_blank" rel="noopener noreferrer">Behance</a>
          </div>
        </div>

        <div class="contact__col col-4 col-md-4 reveal">
          <h3 class="contact__heading">Location</h3>
          <p class="contact__text">
            Palembang,<br />
            South Sumatra,<br />
            Indonesia
          </p>
        </div>

        <div class="contact__col col-4 col-md-4 reveal">
          <h3 class="contact__heading">Availability</h3>
          <p class="contact__text">
            Open to freelance and full-time<br />
            opportunities — remote or on-site.
          </p>
          <div class="contact__status">
            <span class="contact__status-dot"></span>
            <span class="contact__status-text">Available for work</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

