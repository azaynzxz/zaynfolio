---
import Base from "../layouts/Base.astro";
import "../styles/pages/contact.css";

const email = "contact@zaynfolio.com";

const briefSubject = "Project brief: [Channel or company]";
const briefBody = [
  "Hi Achmad,",
  "",
  "Channel or company (with link):",
  "What I need (animated episode, series, motion poster):",
  "Length or number of episodes:",
  "Script or storyboard ready? (yes / need help):",
  "Deadline or release schedule:",
  "Budget range:",
  "Style references (links):",
  "",
  "Thanks,",
  "[Your name]",
].join("\n");

const briefHref = `mailto:${email}?subject=${encodeURIComponent(briefSubject)}&body=${encodeURIComponent(briefBody)}`;
---

<Base
  title="Start a Project | Achmad Zaini, 2D Motion Designer"
  description="Send your script or idea. Get questions, a timeline and a quote within 24 hours. Rigged 2D motion for YouTube and marketing posters."
>
  <!-- ═══ Contact Hero ═══ -->
  <section class="contact-hero section--large" id="contact-hero">
    <div class="container">
      <div class="contact__top">
        <span class="section-label">03 / CONTACT</span>
        <div class="contact__status-pill">
          <span class="contact__status-dot" aria-hidden="true"></span>
          <span class="contact__status-text">Taking new projects &bull; Remote Worldwide</span>
        </div>
      </div>
      <hr class="rule reveal-line" />
    </div>
  </section>

  <!-- ═══ Contact Content & Inquiries ═══ -->
  <section class="contact-content section" id="contact-content">
    <div class="container">
      <!-- Headline & Lead -->
      <div class="contact__intro reveal">
        <h1 class="contact__title">
          Tell me about your video or poster.
        </h1>
        <p class="contact__lead">
          Send the script or a rough idea. I reply within 24 hours with questions, a timeline and a quote.
        </p>
      </div>

      <!-- Quick Inquiry Action Matrix -->
      <div class="contact-matrix grid reveal">
        <!-- Action 01: Email -->
        <div class="contact-card col-4 col-md-4">
          <div class="contact-card__header">
            <svg class="contact-card__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="1" stroke="currentColor" stroke-width="1.5"/>
              <path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span class="contact-card__tag">[ EMAIL ]</span>
          </div>
          <div class="contact-card__body">
            <a href={`mailto:${email}`} class="contact-card__value" id="contact-email">{email}</a>
            <p class="contact-card__sub">Best for briefs and files. Reply within 24 hours.</p>
          </div>
          <div class="contact-card__footer">
            <button class="contact-btn contact-btn--copy" id="copy-email-btn" aria-label="Copy email address to clipboard">
              <svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="8" y="8" width="13" height="13" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <path d="M3 16V4a1 1 0 0 1 1-1h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <svg class="icon-check" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:none">
                <path d="M4 12l5 5L20 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span id="copy-email-tooltip">Copy email</span>
            </button>
            <a href={`mailto:${email}`} class="contact-btn contact-btn--ghost">
              Send email
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Action 02: WhatsApp -->
        <div class="contact-card col-4 col-md-4">
          <div class="contact-card__header">
            <svg class="contact-card__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.417A9.953 9.953 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2Z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M8.5 9.5s.5-1 1.5-1 2 1 2 1l-1 2s1.5 2 3 2.5l1.5-1.5s1 .5 1 1.5-1.5 2-2 2C12 16 8 12 8 9.5 8 9 8.5 9.5 8.5 9.5Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="contact-card__tag">[ WHATSAPP ]</span>
          </div>
          <div class="contact-card__body">
            <span class="contact-card__value">Quick questions</span>
            <p class="contact-card__sub">Fastest for short chats and urgent timelines.</p>
          </div>
          <div class="contact-card__footer">
            <a href="https://wa.me/6281343790990" class="contact-btn contact-btn--wa" target="_blank" rel="noopener noreferrer">
              Message on WhatsApp
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Action 03: Project Brief -->
        <div class="contact-card col-4 col-md-4">
          <div class="contact-card__header">
            <svg class="contact-card__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="1.5"/>
              <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.5"/>
              <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <polyline points="10 9 9 9 8 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span class="contact-card__tag">[ PROJECT BRIEF ]</span>
          </div>
          <div class="contact-card__body">
            <span class="contact-card__value">Send a brief in 2 minutes</span>
            <p class="contact-card__sub">Open the template, fill the blanks, send it to me.</p>
          </div>
          <div class="contact-card__footer">
            <a href={briefHref} class="contact-btn contact-btn--primary" id="contact-brief-btn">
              Open the brief template
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ═══ Process and Background ═══ -->
      <div class="credentials-section">
        <div class="credentials-section__header reveal">
          <span class="section-label">HOW WE WORK</span>
        </div>
        <hr class="rule reveal-line" />

        <!-- Block 01: How it works -->
        <div class="credentials-block reveal">
          <div class="credentials-block__lead">
            <span class="credentials-block__num">[ 01 ]</span>
            <h2 class="credentials-block__heading">How it works</h2>
          </div>
          <div class="credentials-block__content">
            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">1. Send the brief</span>
              </div>
              <p class="credentials-item__desc">Script, length, schedule and budget range.</p>
            </div>
            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">2. I reply within 24 hours</span>
              </div>
              <p class="credentials-item__desc">Questions, a timeline and a quote.</p>
            </div>
            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">3. We start</span>
              </div>
              <p class="credentials-item__desc">Rigging and animation, sound and VFX, then delivery.</p>
            </div>
          </div>
        </div>

        <hr class="rule reveal-line" />

        <!-- Block 02: Ways to work together -->
        <div class="credentials-block reveal">
          <div class="credentials-block__lead">
            <span class="credentials-block__num">[ 02 ]</span>
            <h2 class="credentials-block__heading">Ways to work together</h2>
          </div>
          <div class="credentials-block__content">
            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">Single project</span>
              </div>
              <p class="credentials-item__desc">One episode, one video or a set of marketing posters.</p>
            </div>
            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">Ongoing series</span>
              </div>
              <p class="credentials-item__desc">Regular episodes for a channel on a fixed schedule.</p>
            </div>
          </div>
        </div>

        <hr class="rule reveal-line" />

        <!-- Block 03: Background -->
        <div class="credentials-block reveal">
          <div class="credentials-block__lead">
            <span class="credentials-block__num">[ 03 ]</span>
            <h2 class="credentials-block__heading">Background</h2>
          </div>
          <div class="credentials-block__content">
            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">2D Motion Designer and Production Supervisor</span>
                <span class="credentials-item__period">2021 &mdash; Present</span>
              </div>
              <div class="credentials-item__org">Jakarta studio, remote from Palembang</div>
              <p class="credentials-item__desc">
                I animate static illustrations into YouTube episodes with After Effects rigs, and I handle sound design and VFX. I supervise the illustration, animation and editing team. As of September 2026 I have delivered 124 episodes.
              </p>
            </div>

            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">Tools</span>
              </div>
              <p class="credentials-item__desc">
                After Effects, Premiere Pro, Illustrator, Photoshop, Blender, Duik Angela, Limber, ExtendScript.
              </p>
            </div>

            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">B.Des Visual Communication Design</span>
                <span class="credentials-item__period">2020 &mdash; 2024</span>
              </div>
              <div class="credentials-item__org">Institut Teknologi Sumatera (ITERA)</div>
              <p class="credentials-item__desc">Cum Laude, GPA 3.78 / 4.00.</p>
            </div>

            <div class="credentials-item">
              <div class="credentials-item__meta">
                <span class="credentials-item__role">Location</span>
              </div>
              <p class="credentials-item__desc">
                Palembang, South Sumatra, Indonesia (UTC+7). Working remotely with clients worldwide.
              </p>
            </div>
          </div>
        </div>

        <hr class="rule reveal-line" />

        <!-- Block 04: Profiles -->
        <div class="credentials-block reveal">
          <div class="credentials-block__lead">
            <span class="credentials-block__num">[ 04 ]</span>
            <h2 class="credentials-block__heading">Profiles</h2>
          </div>
          <div class="credentials-block__content">
            <div class="social-links-grid">
              <a href="https://www.linkedin.com/in/azaynz/" target="_blank" rel="noopener noreferrer" class="social-link-item">
                <span class="social-link-item__name">LinkedIn</span>
                <span class="social-link-item__handle">in/azaynz</span>
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

              <a href="https://behance.net/azaynz" target="_blank" rel="noopener noreferrer" class="social-link-item">
                <span class="social-link-item__name">Behance</span>
                <span class="social-link-item__handle">behance.net/azaynz</span>
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

              <a href="https://instagram.com/azaynz" target="_blank" rel="noopener noreferrer" class="social-link-item">
                <span class="social-link-item__name">Instagram</span>
                <span class="social-link-item__handle">@azaynz</span>
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M3 13L13 3M13 3H5M13 3V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  function initContact() {
    const copyBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
    if (!copyBtn) return;

    const iconCopy = copyBtn.querySelector('.icon-copy') as SVGElement | null;
    const iconCheck = copyBtn.querySelector('.icon-check') as SVGElement | null;
    const tooltip = document.getElementById('copy-email-tooltip');

    copyBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      try {
        await navigator.clipboard.writeText('contact@zaynfolio.com');
        if (iconCopy) iconCopy.style.display = 'none';
        if (iconCheck) iconCheck.style.display = 'block';
        if (tooltip) tooltip.textContent = 'Copied to clipboard';
        copyBtn.classList.add('contact-btn--copied');
        setTimeout(() => {
          if (iconCopy) iconCopy.style.display = 'block';
          if (iconCheck) iconCheck.style.display = 'none';
          if (tooltip) tooltip.textContent = 'Copy email';
          copyBtn.classList.remove('contact-btn--copied');
        }, 2200);
      } catch {
        (document.getElementById('contact-email') as HTMLElement)?.focus();
      }
    });
  }

  document.addEventListener('astro:page-load', initContact);
</script>
