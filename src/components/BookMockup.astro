---
interface Props {
  cover: string;
  title: string;
  pages?: string | number;
  aspectRatio?: number;
  class?: string;
}

const {
  cover,
  title,
  pages,
  aspectRatio = 1.4139, // Default A4 landscape (1684 / 1191)
  class: className = ''
} = Astro.props;

// Unique identifier to prevent SVG clip-path/gradient collisions across multiple cards
const uid = 'bm-' + Math.random().toString(36).substring(2, 9);

// ── Strict Geometry Calculations ──
const ratio = Number(aspectRatio) > 0 ? Number(aspectRatio) : 1.4139;

// Anatomy specifications in SVG units (viewBox = 460 x 280)
const spineWidth = 11;
const pageBlockRight = 9;
const pageBlockBottom = 7;

// Calculate cover dimensions ensuring it stays centered and NEVER gets clipped
// Available stage area: ~350px width x ~200px height
let coverW = 0;
let coverH = 0;

if (ratio >= 1.6) {
  // Widescreen 16:9 (e.g. Dr. Koffie with ratio 1.7778)
  coverW = 312;
  coverH = Math.round(coverW / ratio); // ~176px
} else {
  // Standard A4 Landscape (~1.414)
  coverH = 186;
  coverW = Math.round(coverH * ratio); // 186 * 1.4139 = 263px
}

// Full book assembly bounds
const totalBookW = spineWidth + coverW + pageBlockRight;
const totalBookH = coverH + pageBlockBottom;

// Centering within 460 x 280 viewBox
const bookX = Math.round((460 - totalBookW) / 2);
const bookY = Math.round((244 - totalBookH) / 2) + 6;

// Spine placement (Positioned directly to the LEFT of the front cover — ZERO overlap onto artwork)
const spineX = bookX;
const spineY = bookY;
const spineW = spineWidth;
const spineH = coverH;

// Front cover artwork placement (Starts immediately at bookX + spineW)
const coverX = bookX + spineWidth;
const coverY = bookY;

// Right page block placement (Stacked sheets to the right of the front cover)
const rightPagesX = coverX + coverW;
const rightPagesY = coverY + 2;
const rightPagesW = pageBlockRight;

// Bottom page block placement (Stacked sheets underneath front cover and spine)
const bottomPagesX = spineX + 5;
const bottomPagesY = coverY + coverH;
const bottomPagesH = pageBlockBottom;

// Hardcover back board substrate (Structural shell slightly wider than pages)
const backShellX = spineX - 1;
const backShellY = bookY - 1;
const backShellW = totalBookW + 2;
const backShellH = totalBookH + 2;

// Ambient ground shadow ellipse
const shadowCx = bookX + Math.round(totalBookW / 2);
const shadowCy = bottomPagesY + bottomPagesH + 7;
const shadowRx = Math.round(totalBookW * 0.52);
const shadowRy = 11;
---

<div class:list={['book-mockup-stage', className]}>
  <svg
    class="book-mockup-svg"
    viewBox="0 0 460 280"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    xmlns:xlink="http://www.w3.org/1999/xlink"
    role="img"
    aria-label={`Brandbook mockup for ${title}${pages ? ` (${pages} pages)` : ''}`}
  >
    <defs>
      <!-- Soft ambient floor shadow -->
      <filter id={`${uid}-ambient-blur`} x="-20%" y="-20%" width="140%" height="180%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="9" />
      </filter>

      <!-- Tight contact shadow under the base -->
      <filter id={`${uid}-contact-blur`} x="-10%" y="-10%" width="120%" height="160%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" />
      </filter>

      <!-- Front Cover Clip Path: Matches exact cover dimension -->
      <clipPath id={`${uid}-cover-clip`}>
        <rect x={coverX} y={coverY} width={coverW} height={coverH} rx="1.5" ry="1.5" />
      </clipPath>

      <!-- Hardcover Spine Cylindrical Gradient (Curved 3D binding to the left of cover) -->
      <linearGradient id={`${uid}-spine-curved`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#141517" />
        <stop offset="28%" stop-color="#34373d" />
        <stop offset="65%" stop-color="#1e1f23" />
        <stop offset="90%" stop-color="#111214" />
        <stop offset="100%" stop-color="#090a0b" />
      </linearGradient>

      <!-- Bottom Stacked Paper Edge Gradient -->
      <linearGradient id={`${uid}-pages-bottom`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#d6d6cd" />
        <stop offset="25%" stop-color="#fdfdfa" />
        <stop offset="50%" stop-color="#e6e6df" />
        <stop offset="75%" stop-color="#f4f4ee" />
        <stop offset="90%" stop-color="#d4d4cb" />
        <stop offset="100%" stop-color="#bcbcb2" />
      </linearGradient>

      <!-- Right Vertical Stacked Paper Edge Gradient -->
      <linearGradient id={`${uid}-pages-right`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#ecece5" />
        <stop offset="40%" stop-color="#deded5" />
        <stop offset="75%" stop-color="#cfcfc5" />
        <stop offset="100%" stop-color="#b8b8ae" />
      </linearGradient>

      <!-- Delicate Inner Gutter Shade (Subtle depth right next to hinge, does NOT cover text) -->
      <linearGradient id={`${uid}-gutter`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#000000" stop-opacity="0.14" />
        <stop offset="100%" stop-color="#000000" stop-opacity="0.0" />
      </linearGradient>

      <!-- Diagonal Paper Surface Sheen (Subtle tactile satin sheen) -->
      <linearGradient id={`${uid}-sheen`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.10" />
        <stop offset="30%" stop-color="#ffffff" stop-opacity="0.02" />
        <stop offset="70%" stop-color="#000000" stop-opacity="0.01" />
        <stop offset="100%" stop-color="#000000" stop-opacity="0.12" />
      </linearGradient>
    </defs>

    <!-- 1. Ground Shadow Group (remains anchored) -->
    <g class="book-mockup-shadow">
      <!-- Ambient Floor Shadow -->
      <ellipse cx={shadowCx} cy={shadowCy} rx={shadowRx} ry={shadowRy} fill="rgba(0, 0, 0, 0.28)" filter={`url(#${uid}-ambient-blur)`} />
      <!-- Tight contact shadow directly beneath base -->
      <path
        d={`M ${bottomPagesX - 2} ${bottomPagesY + 1} L ${rightPagesX + rightPagesW} ${bottomPagesY + 1} L ${rightPagesX + rightPagesW + 5} ${bottomPagesY + bottomPagesH + 4} L ${bottomPagesX + 4} ${bottomPagesY + bottomPagesH + 4} Z`}
        fill="rgba(0, 0, 0, 0.38)"
        filter={`url(#${uid}-contact-blur)`}
      />
    </g>

    <!-- 2. Physical Book Body Group (lifts realistically on hover) -->
    <g class="book-mockup-body">
      <!-- Hardcover Back Shell (Dark structural base) -->
      <rect
        x={backShellX}
        y={backShellY}
        width={backShellW}
        height={backShellH}
        rx="3"
        fill="#141518"
        stroke="rgba(255, 255, 255, 0.08)"
        stroke-width="0.75"
      />

      <!-- Paper Thickness - Bottom Page Edge -->
      <path
        d={`M ${bottomPagesX} ${bottomPagesY} L ${rightPagesX} ${bottomPagesY} L ${rightPagesX + rightPagesW - 1} ${bottomPagesY + bottomPagesH} L ${bottomPagesX + 3} ${bottomPagesY + bottomPagesH} Z`}
        fill={`url(#${uid}-pages-bottom)`}
      />
      <!-- Delicate bottom page line striations -->
      <line x1={bottomPagesX + 2} y1={bottomPagesY + 2.4} x2={rightPagesX + rightPagesW - 2} y2={bottomPagesY + 2.4} stroke="rgba(0, 0, 0, 0.14)" stroke-width="0.5" />
      <line x1={bottomPagesX + 4} y1={bottomPagesY + 4.6} x2={rightPagesX + rightPagesW - 3} y2={bottomPagesY + 4.6} stroke="rgba(0, 0, 0, 0.16)" stroke-width="0.5" />

      <!-- Paper Thickness - Right Page Edge -->
      <path
        d={`M ${rightPagesX} ${rightPagesY} L ${rightPagesX + rightPagesW} ${rightPagesY + 3} L ${rightPagesX + rightPagesW} ${bottomPagesY + bottomPagesH} L ${rightPagesX} ${bottomPagesY} Z`}
        fill={`url(#${uid}-pages-right)`}
      />
      <!-- Delicate right page line striations -->
      <line x1={rightPagesX + 3} y1={rightPagesY + 3} x2={rightPagesX + 3} y2={bottomPagesY + bottomPagesH - 2} stroke="rgba(0, 0, 0, 0.14)" stroke-width="0.5" />
      <line x1={rightPagesX + 6} y1={rightPagesY + 5} x2={rightPagesX + 6} y2={bottomPagesY + bottomPagesH - 1} stroke="rgba(0, 0, 0, 0.16)" stroke-width="0.5" />

      <!-- Hardcover Spine (Physical bound left edge — completely outside cover artwork) -->
      <rect
        x={spineX}
        y={spineY}
        width={spineW}
        height={spineH}
        rx="2"
        fill={`url(#${uid}-spine-curved)`}
      />

      <!-- Front Cover Artwork (Sits immediately to the right of the spine — 100% visible, zero crop) -->
      <g clip-path={`url(#${uid}-cover-clip)`}>
        <image
          href={cover}
          xlink:href={cover}
          x={coverX}
          y={coverY}
          width={coverW}
          height={coverH}
          preserveAspectRatio="none"
        />
        <!-- Micro Gutter Shadow on the leftmost 6px only -->
        <rect x={coverX} y={coverY} width="6" height={coverH} fill={`url(#${uid}-gutter)`} pointer-events="none" />
      </g>

      <!-- Spine Hinge Crease Groove (Defines the boundary between spine and front board) -->
      <line x1={coverX} y1={coverY} x2={coverX} y2={coverY + coverH} stroke="rgba(0, 0, 0, 0.45)" stroke-width="1.2" />
      <line x1={coverX + 0.8} y1={coverY} x2={coverX + 0.8} y2={coverY + coverH} stroke="rgba(255, 255, 255, 0.24)" stroke-width="0.6" />

      <!-- Paper Sheen / Natural Satin Reflection across cover -->
      <rect x={coverX} y={coverY} width={coverW} height={coverH} rx="1.5" fill={`url(#${uid}-sheen)`} pointer-events="none" />

      <!-- Crisp Outer Rim Highlight -->
      <rect
        x={coverX + 0.5}
        y={coverY + 0.5}
        width={coverW - 1}
        height={coverH - 1}
        rx="1.2"
        fill="none"
        stroke="rgba(255, 255, 255, 0.3)"
        stroke-width="0.75"
        pointer-events="none"
      />
    </g>
  </svg>
</div>

<style>
  .book-mockup-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) 0;
    background: transparent;
    overflow: visible;
  }

  .book-mockup-svg {
    width: 100%;
    height: auto;
    max-height: 100%;
    display: block;
    overflow: visible;
  }

  .book-mockup-body {
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: 230px 240px;
    will-change: transform;
  }

  .book-mockup-shadow {
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s ease;
    transform-origin: 230px 255px;
    will-change: transform, opacity;
  }

  /* Interactive Hover Physics: Book body lifts up smoothly, floor shadow softens */
  :global(.event-card:hover) .book-mockup-body {
    transform: translateY(-7px) scale(1.018);
  }

  :global(.event-card:hover) .book-mockup-shadow {
    transform: scale(0.96) translateY(2px);
    opacity: 0.8;
  }

  [data-theme="dark"] .book-mockup-stage {
    background: transparent;
  }

  @media (max-width: 640px) {
    .book-mockup-stage {
      padding: 0;
    }
  }
</style>
