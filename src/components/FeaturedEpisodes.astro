---
import episodes from '../data/episodes.json';

const ROLE = 'Rigging and animation, sound design, VFX';
---

<section class="episodes section" id="episodes" aria-labelledby="episodes-heading">
  <div class="container">
    <div class="episodes__header reveal">
      <span class="section-label">01 &mdash; Featured episodes</span>
      <span class="episodes__meta">Published on the channels listed</span>
    </div>
    <hr class="rule reveal-line" />

    <h2 class="episodes__heading reveal" id="episodes-heading">Episodes I worked on.</h2>
    <p class="episodes__role reveal">My role: {ROLE}.</p>

    <ul class="episodes__grid">
      {episodes.map((ep) => (
        <li class="episode reveal">
          <div class="episode__frame" data-youtube-id={ep.youtubeId} data-title={ep.title}>
            <button type="button" class="episode__play" aria-label={`Play ${ep.title}`}>
              <img
                class="episode__thumb"
                src={`https://i.ytimg.com/vi/${ep.youtubeId}/hqdefault.jpg`}
                alt=""
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
              />
              <span class="episode__icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M4 2.5L13 8L4 13.5V2.5Z" /></svg>
              </span>
            </button>
          </div>
          <div class="episode__caption">
            <h3 class="episode__title">{ep.title}</h3>
            <p class="episode__meta">{ep.channel} &bull; {ep.views} views</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  function initEpisodes() {
    document.querySelectorAll<HTMLElement>('.episode__frame').forEach((frame) => {
      const btn = frame.querySelector('.episode__play');
      if (!btn || (frame as any)._bound) return;
      (frame as any)._bound = true;
      btn.addEventListener('click', () => {
        const id = frame.dataset.youtubeId;
        if (!id) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = frame.dataset.title || 'YouTube video';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.className = 'episode__iframe';
        iframe.style.position = 'absolute';
        iframe.style.inset = '0';
        iframe.style.width = '100%';
        iframe.style.height = '100%';
        iframe.style.border = '0';
        frame.replaceChildren(iframe);
      });
    });
  }

  initEpisodes();
  document.addEventListener('astro:page-load', initEpisodes);
</script>

<style>
  .episodes__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-3);
  }

  .episodes__meta {
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--muted);
  }

  .episodes__heading {
    margin-top: var(--space-5);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    color: var(--fg);
  }

  .episodes__role {
    margin-top: var(--space-2);
    font-size: var(--fs-body);
    color: var(--muted);
  }

  .episodes__grid {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .episode {
    display: flex;
    flex-direction: column;
  }

  .episode__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: #000;
    border: 1px solid var(--rule);
    overflow: hidden;
  }

  .episode__play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .episode__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--ease-out), opacity 0.3s var(--ease-out);
  }

  .episode__play:hover .episode__thumb {
    transform: scale(1.03);
  }

  .episode__icon {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 48px;
    height: 48px;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    background: var(--fg);
    color: var(--bg);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .episode__play:hover .episode__icon {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .episode__play:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
  }

  :global(.episode__iframe),
  .episode__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .episode__caption {
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .episode__title {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
    color: var(--fg);
    line-height: var(--leading-snug);
  }

  .episode__meta {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (max-width: 1024px) {
    .episodes__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--space-3);
    }
  }

  @media (max-width: 720px) {
    .episodes__grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
