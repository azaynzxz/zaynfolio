---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  pages: string[];
  backUrl?: string;
  aspectRatio?: number;
}

const {
  title,
  pages,
  backUrl = '/work',
  aspectRatio = 1.4139, // Default A4 landscape (1684 / 1191)
} = Astro.props;

// Ensure even number of pages so book can close properly to back cover in double mode
const displayPages = [...pages];
if (displayPages.length % 2 !== 0) {
  displayPages.push(''); // Blank back cover
}

// Preload the first 6 pages for instant flipping
const preloadPages = pages.slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <title>{title} — Achmad Zaini</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <ClientRouter />

    <!-- Preload first few pages for rapid initial interaction -->
    {preloadPages.map((src) => (
      <link rel="preload" as="image" href={src} />
    ))}

    <!-- Global jQuery and Turn.js -->
    <script is:inline src="/vendor/turnjs/jquery.min.js"></script>
    <script is:inline src="/vendor/turnjs/turn.min.js"></script>

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-tap-highlight-color: transparent;
      }

      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #08080a;
        user-select: none;
        -webkit-user-select: none;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }

      /* ── Seamless Page Transitions (View Transition API) ───────── */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.5s;
        animation-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
        mix-blend-mode: normal;
      }

      ::view-transition-old(root) {
        animation-name: fadeOutAndScale;
      }

      ::view-transition-new(root) {
        animation-name: fadeInAndScale;
      }

      @keyframes fadeOutAndScale {
        from { opacity: 1; transform: scale(1); filter: blur(0px); }
        to { opacity: 0; transform: scale(0.98); filter: blur(4px); }
      }

      @keyframes fadeInAndScale {
        from { opacity: 0; transform: scale(1.02); filter: blur(4px); }
        to { opacity: 1; transform: scale(1); filter: blur(0px); }
      }

      /* Fullscreen Stage with gallery spotlight backdrop */
      .stage {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(ellipse at 50% 48%, #17181c 0%, #0a0b0d 65%, #040405 100%);
        overflow: hidden;
        cursor: default;
      }

      /* Minimal floating glassmorphic nav buttons */
      .nav-btn {
        position: fixed;
        top: 18px;
        z-index: 1000;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: rgba(255, 255, 255, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        outline: none;
        text-decoration: none;
      }

      .nav-btn:hover {
        background: rgba(255, 255, 255, 0.18);
        color: #ffffff;
        transform: scale(1.06);
      }

      .nav-btn:active {
        transform: scale(0.96);
      }

      .back-btn {
        left: 18px;
      }

      .rotate-btn {
        right: 18px;
      }

      /* Hide rotate button on desktop screens; only show on mobile */
      @media (min-width: 769px) {
        .rotate-btn {
          display: none !important;
        }
      }

      .rotate-btn.active {
        background: rgba(255, 255, 255, 0.22);
        border-color: rgba(255, 255, 255, 0.45);
        color: #ffffff;
      }

      .rotate-btn svg {
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .rotate-btn.active svg {
        transform: rotate(90deg);
      }

      @media (min-width: 1025px) {
        .nav-btn {
          opacity: 0.6;
        }
        .nav-btn:hover {
          opacity: 1;
        }
      }

      /* Viewport wrapper */
      .flipbook-viewport {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        perspective: 2400px;
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Rotated 90deg mode for mobile landscape reading */
      .stage.is-rotated-90 .flipbook-viewport {
        width: 100vh;
        height: 100vw;
        transform: rotate(90deg);
      }

      /* The Flipbook container */
      .flipbook {
        position: relative;
        margin: 0 auto;
        touch-action: none;
        /* Ambient drop shadows for physical book depth */
        filter: drop-shadow(0 25px 45px rgba(0, 0, 0, 0.7)) drop-shadow(0 8px 16px rgba(0, 0, 0, 0.45));
        transition: margin-left 0.45s cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Pages with tactile paper look and grab cursor */
      .flipbook .page {
        background-color: #121316;
        background-size: 100% 100%;
        background-repeat: no-repeat;
        background-position: center;
        overflow: hidden;
        box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
        cursor: grab;
      }

      /* Realistic spine curvature and gutter shadow when open */
      .flipbook .page.even::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to right,
          rgba(0, 0, 0, 0) 80%,
          rgba(0, 0, 0, 0.05) 92%,
          rgba(0, 0, 0, 0.22) 100%
        );
        pointer-events: none;
      }

      .flipbook .page.odd::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to left,
          rgba(0, 0, 0, 0) 80%,
          rgba(0, 0, 0, 0.05) 92%,
          rgba(0, 0, 0, 0.22) 100%
        );
        pointer-events: none;
      }

      /* Subtle paper edge highlight */
      .flipbook .page.even::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 1px;
        background: rgba(255, 255, 255, 0.3);
        pointer-events: none;
      }

      .flipbook .page.odd::before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        right: 0;
        width: 1px;
        background: rgba(255, 255, 255, 0.3);
        pointer-events: none;
      }

      /* Active dragging state */
      body.is-dragging,
      body.is-dragging *,
      .flipbook:active,
      .flipbook .page:active {
        cursor: grabbing !important;
      }
    </style>
  </head>
  <body>
    <main class="stage" id="stage">
      <!-- Minimalist back button to return to portfolio -->
      <a
        href={backUrl}
        id="back-btn"
        class="nav-btn back-btn"
        aria-label="Back to portfolio"
        title="Back to portfolio"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
      </a>

      <!-- Minimalist mobile rotate button (switches to horizontal landscape) -->
      <button
        id="rotate-btn"
        class="nav-btn rotate-btn"
        type="button"
        aria-label="Rotate book horizontally"
        title="Rotate horizontally"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path>
          <polyline points="21 3 21 8 16 8"></polyline>
        </svg>
      </button>

      <!-- Pure flipbook viewport: zero clutter, 100% direct tactile interaction -->
      <div class="flipbook-viewport" id="viewport">
        <div id="flipbook" class="flipbook" data-aspect-ratio={aspectRatio}>
          {displayPages.map((src, index) => (
            <div
              class="page"
              data-page-num={index + 1}
              style={src ? `background-image: url('${src}');` : 'background-color: #0d0e12;'}
            ></div>
          ))}
        </div>
      </div>
    </main>

    <script is:inline define:vars={{ backUrl, aspectRatio }}>
      (function() {
        const PAGE_RATIO = aspectRatio || 1.4139;
        let audioCtx = null;
        let isRotated = false;
        window.turnJsRotated90 = false;
        let touchStartX = 0;
        let touchStartY = 0;

        // Realistic paper turn audio synthesized via Web Audio API
        function playPaperSound() {
          try {
            if (!audioCtx) {
              const AudioCtx = window.AudioContext || window['webkitAudioContext'];
              if (AudioCtx) audioCtx = new AudioCtx();
            }
            if (audioCtx && audioCtx.state === 'suspended') {
              audioCtx.resume();
            }
            if (!audioCtx) return;

            const duration = 0.12;
            const bufferSize = Math.floor(audioCtx.sampleRate * duration);
            const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
            const data = buffer.getChannelData(0);
            for (let i = 0; i < bufferSize; i++) {
              data[i] = Math.random() * 2 - 1;
            }

            const noise = audioCtx.createBufferSource();
            noise.buffer = buffer;

            const filter = audioCtx.createBiquadFilter();
            filter.type = 'bandpass';
            filter.frequency.setValueAtTime(1200, audioCtx.currentTime);
            filter.Q.setValueAtTime(1.0, audioCtx.currentTime);
            filter.frequency.exponentialRampToValueAtTime(500, audioCtx.currentTime + duration);

            const gain = audioCtx.createGain();
            const now = audioCtx.currentTime;
            gain.gain.setValueAtTime(0.001, now);
            gain.gain.linearRampToValueAtTime(0.06, now + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

            noise.connect(filter);
            filter.connect(gain);
            gain.connect(audioCtx.destination);

            noise.start(now);
            noise.stop(now + duration);
          } catch (e) {
            // Graceful fallback if audio is restricted
          }
        }

        // Calculate size maximizing fullscreen view with precise aspect ratio
        function calcSize() {
          const isMobile = window.innerWidth < 768;
          let availW, availH;

          if (isRotated) {
            availW = window.innerHeight - 36;
            availH = window.innerWidth - 24;
          } else {
            availW = window.innerWidth - (isMobile ? 16 : 48);
            availH = window.innerHeight - (isMobile ? 24 : 48);
          }

          const displayMode = (isRotated || !isMobile) ? 'double' : 'single';
          const spreadRatio = (displayMode === 'double') ? PAGE_RATIO * 2 : PAGE_RATIO;

          let w = availW;
          let h = w / spreadRatio;

          if (h > availH) {
            h = availH;
            w = h * spreadRatio;
          }

          w = Math.floor(w);
          if (displayMode === 'double' && w % 2 !== 0) w -= 1;
          h = Math.floor(h);

          return {
            width: w,
            height: h,
            display: displayMode
          };
        }

        function applySizeAndRotation() {
          const $ = window.jQuery;
          if (!$) return;
          const $book = $('#flipbook');
          if (!$book.length || typeof $book.turn !== 'function' || !$book.turn('is')) return;
          const newSize = calcSize();
          $book.turn('display', newSize.display);
          $book.turn('size', newSize.width, newSize.height);
          $book.turn('resize');
        }

        function toggleRotation() {
          isRotated = !isRotated;
          window.turnJsRotated90 = isRotated;
          const stage = document.getElementById('stage');
          const rotateBtn = document.getElementById('rotate-btn');

          if (isRotated) {
            if (stage) stage.classList.add('is-rotated-90');
            if (rotateBtn) rotateBtn.classList.add('active');
          } else {
            if (stage) stage.classList.remove('is-rotated-90');
            if (rotateBtn) rotateBtn.classList.remove('active');
          }

          setTimeout(function() {
            applySizeAndRotation();
          }, 60);
        }

        function toggleFullscreen() {
          if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
          } else if (document.exitFullscreen) {
            document.exitFullscreen().catch(() => {});
          }
        }

        function handleTouchStart(e) {
          if (!e.changedTouches || !e.changedTouches.length) return;
          touchStartX = e.changedTouches[0].screenX;
          touchStartY = e.changedTouches[0].screenY;
        }

        function handleTouchEnd(e) {
          if (!e.changedTouches || !e.changedTouches.length) return;
          const $ = window.jQuery;
          if (!$) return;
          const $book = $('#flipbook');
          if (!$book.length || typeof $book.turn !== 'function' || !$book.turn('is')) return;

          const touchEndX = e.changedTouches[0].screenX;
          const touchEndY = e.changedTouches[0].screenY;
          const dx = touchEndX - touchStartX;
          const dy = touchEndY - touchStartY;

          if (isRotated) {
            if (Math.abs(dy) > 40 && Math.abs(dx) < 80) {
              if (dy < 0) {
                $book.turn('next');
              } else {
                $book.turn('previous');
              }
            }
          } else {
            if (Math.abs(dx) > 40 && Math.abs(dy) < 80) {
              if (dx < 0) {
                $book.turn('next');
              } else {
                $book.turn('previous');
              }
            }
          }
        }

        function cleanupListeners() {
          if (window.jQuery) {
            const $ = window.jQuery;
            $(window).off('.flipbook');
            $(document).off('.flipbook');
            $('#stage').off('.flipbook');
            $('#rotate-btn').off('.flipbook');
          }
          document.removeEventListener('touchstart', handleTouchStart);
          document.removeEventListener('touchend', handleTouchEnd);
        }

        function init() {
          const $ = window.jQuery;
          if (!$) return;
          const $book = $('#flipbook');
          if (!$book.length || typeof $book.turn !== 'function' || $book.turn('is')) return;

          cleanupListeners();

          const size = calcSize();

          // Initialize Turn.js with full drag sensitivity
          $book.turn({
            width: size.width,
            height: size.height,
            display: size.display,
            elevation: 70,
            gradients: true,
            acceleration: true,
            duration: 650,
            autoCenter: true,
            turnCorners: 'tl,tr,bl,br',
            cornerSize: 120,
            when: {
              turning: function() {
                playPaperSound();
              },
              turned: function(_e, page) {
                if (page === 1) {
                  setTimeout(function() {
                    if ($book.turn('page') === 1) {
                      $book.turn('peel', 'br');
                    }
                  }, 400);
                }
              },
              start: function() {
                document.body.classList.add('is-dragging');
              },
              end: function() {
                document.body.classList.remove('is-dragging');
              }
            }
          });

          // Initial peel cue on cover after slight delay
          setTimeout(function() {
            if ($book.turn('is') && $book.turn('page') === 1) {
              $book.turn('peel', 'br');
            }
          }, 600);

          // Rotate button listener
          $('#rotate-btn').on('click.flipbook', function(e) {
            e.stopPropagation();
            toggleRotation();
          });

          // Dynamic responsive resizing
          let resizeTimer;
          $(window).on('resize.flipbook orientationchange.flipbook', function() {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function() {
              applySizeAndRotation();
            }, 80);
          });

          // Keyboard navigation
          $(document).on('keydown.flipbook', function(e) {
            if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown' || e.key === 'ArrowDown') {
              $book.turn('next');
            } else if (e.key === 'ArrowLeft' || e.key === 'Backspace' || e.key === 'PageUp' || e.key === 'ArrowUp') {
              $book.turn('previous');
            } else if (e.key === 'Home') {
              $book.turn('page', 1);
            } else if (e.key === 'End') {
              $book.turn('page', $book.turn('pages'));
            } else if (e.key === 'r' || e.key === 'R') {
              toggleRotation();
            } else if (e.key === 'f' || e.key === 'F') {
              toggleFullscreen();
            } else if (e.key === 'Escape') {
              if (document.fullscreenElement) {
                document.exitFullscreen();
              } else {
                const backBtn = document.getElementById('back-btn');
                if (backBtn) {
                  backBtn.click();
                } else {
                  window.location.href = backUrl || '/work';
                }
              }
            }
          });

          // Mouse wheel / trackpad scroll flip
          let wheelCooldown = false;
          $('#stage').on('wheel.flipbook', function(e) {
            if (wheelCooldown) return;
            const delta = e.originalEvent.deltaY || e.originalEvent.deltaX;
            if (Math.abs(delta) > 20) {
              wheelCooldown = true;
              if (delta > 0) {
                $book.turn('next');
              } else {
                $book.turn('previous');
              }
              setTimeout(function() {
                wheelCooldown = false;
              }, 400);
            }
          });

          // Click on empty stage backdrop outside book to flip
          $('#stage').on('click.flipbook', function(e) {
            if (e.target.id === 'stage' || e.target.id === 'viewport') {
              if (isRotated) {
                if (e.pageY > window.innerHeight / 2) {
                  $book.turn('next');
                } else {
                  $book.turn('previous');
                }
              } else {
                if (e.pageX > window.innerWidth / 2) {
                  $book.turn('next');
                } else {
                  $book.turn('previous');
                }
              }
            }
          });

          // Mobile touch swipe gestures (adapts when rotated)
          document.addEventListener('touchstart', handleTouchStart, { passive: true });
          document.addEventListener('touchend', handleTouchEnd, { passive: true });

          // Double click stage backdrop to toggle native fullscreen
          $('#stage').on('dblclick.flipbook', function(e) {
            if (e.target.id === 'stage' || e.target.id === 'viewport') {
              toggleFullscreen();
            }
          });
        }

        function ensureTurnJs(cb) {
          if (
            typeof window.jQuery !== 'undefined' &&
            typeof window.jQuery.fn !== 'undefined' &&
            typeof window.jQuery.fn.turn === 'function'
          ) {
            cb();
            return;
          }

          const start = Date.now();
          const timer = setInterval(function() {
            if (
              typeof window.jQuery !== 'undefined' &&
              typeof window.jQuery.fn !== 'undefined' &&
              typeof window.jQuery.fn.turn === 'function'
            ) {
              clearInterval(timer);
              cb();
            } else if (Date.now() - start > 6000) {
              clearInterval(timer);
            }
          }, 20);
        }

        function tryInit() {
          const flipbookEl = document.getElementById('flipbook');
          if (!flipbookEl) return;

          ensureTurnJs(function() {
            const $ = window.jQuery;
            const $book = $('#flipbook');
            if (!$book.length || typeof $book.turn !== 'function' || $book.turn('is')) return;
            init();
          });
        }

        // Astro View Transitions lifecycle
        document.addEventListener('astro:page-load', tryInit);
        document.addEventListener('astro:before-swap', cleanupListeners, { once: true });

        // Fallback for direct browser document readiness
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
          tryInit();
        } else {
          document.addEventListener('DOMContentLoaded', tryInit);
        }
      })();
    </script>
  </body>
</html>
