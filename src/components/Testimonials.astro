---
import testimonialsData from '../data/testimonials.json';

interface Props {
  category?: 'all' | 'motion' | 'graphic-design';
  limit?: number;
  columns?: 2 | 3;
  sectionNumber?: string;
  title?: string;
  subtitle?: string;
}

const {
  category = 'all',
  limit,
  columns = category === 'graphic-design' ? 3 : 2,
  sectionNumber = '03',
  title = 'Clients Testimonial',
  subtitle = 'Feedback from studio leads, founders, and brand partners.'
} = Astro.props;

let testimonials = category === 'all' 
  ? testimonialsData 
  : testimonialsData.filter((item) => item.category === category);

if (limit && limit > 0) {
  testimonials = testimonials.slice(0, limit);
}
---

<section class="testimonials section" id="endorsements" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="testimonials__header reveal">
      <span class="section-label">{sectionNumber} &mdash; Social Proof</span>
      <span class="testimonials__meta">{testimonials.length} Testimonials</span>
    </div>
    <hr class="rule reveal-line" />

    <div class="testimonials__intro reveal">
      <h2 class="testimonials__heading" id="testimonials-heading">{title}</h2>
      <p class="testimonials__subtitle">{subtitle}</p>
    </div>

    <div class:list={['testimonials__grid', `testimonials__grid--cols-${columns}`]}>
      {testimonials.map((item) => (
        <article class:list={['testimonial-card', 'reveal', `testimonial-card--${category}`]} data-category={item.category}>
          <div class="testimonial-card__header">
            <span class="testimonial-card__tag">
              {item.category === 'motion' ? 'Motion & Animation' : 'Brand & Identity'}
            </span>
            <span class="testimonial-card__id">{item.id}</span>
          </div>

          <blockquote class="testimonial-card__quote">
            <p>&ldquo;{item.quote}&rdquo;</p>
          </blockquote>

          <div class="testimonial-card__footer">
            <div class="testimonial-card__author-info">
              <strong class="testimonial-card__name">{item.name}</strong>
              <span class="testimonial-card__role">{item.role}</span>
              <span class="testimonial-card__company">{item.company}</span>
            </div>
            {item.highlight && (
              <span class="testimonial-card__highlight">{item.highlight}</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-top: clamp(36px, 4.5vw, 64px);
    padding-bottom: clamp(36px, 4.5vw, 64px);
    border-bottom: 1px solid var(--rule);
  }

  .testimonials__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .testimonials__meta {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .testimonials__intro {
    margin-top: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .testimonials__heading {
    font-size: clamp(22px, 2.6vw, 32px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--fg);
    margin-bottom: 6px;
  }

  .testimonials__subtitle {
    font-size: clamp(13px, 1.05vw, 15px);
    color: var(--fg-muted);
    line-height: 1.45;
  }

  /* Grid Layouts */
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-4);
    align-items: stretch;
  }

  /* 2 Column Variant (Desktop) */
  .testimonials__grid--cols-2 .testimonial-card {
    grid-column: span 6;
  }

  /* 3 Column Variant (Desktop) */
  .testimonials__grid--cols-3 .testimonial-card {
    grid-column: span 4;
  }

  /* Dense & Compact Card Styling */
  .testimonial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 20px;
    background: var(--bg);
    border: 1px solid var(--rule);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .testimonial-card:hover {
    border-color: var(--fg-muted);
    background: rgba(0, 0, 0, 0.015);
  }

  [data-theme="dark"] .testimonial-card:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .testimonial-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--rule);
  }

  .testimonial-card__tag {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 600;
  }

  .testimonial-card__id {
    font-size: 10px;
    color: var(--fg-muted);
    font-family: monospace;
    opacity: 0.7;
  }

  .testimonial-card__quote {
    margin: 0 0 14px 0;
    font-size: clamp(13px, 1vw, 14px);
    line-height: 1.5;
    color: var(--fg);
    font-weight: 400;
  }

  .testimonial-card__footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
  }

  .testimonial-card__author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial-card__name {
    font-size: 13px;
    font-weight: 700;
    color: var(--fg);
  }

  .testimonial-card__role {
    font-size: 11.5px;
    color: var(--fg-muted);
    line-height: 1.3;
  }

  .testimonial-card__company {
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
    opacity: 0.85;
  }

  .testimonial-card__highlight {
    align-self: flex-start;
    display: inline-block;
    font-size: 9.5px;
    letter-spacing: 0.03em;
    padding: 2px 7px;
    background: rgba(232, 160, 144, 0.08);
    border: 1px solid rgba(232, 160, 144, 0.25);
    color: var(--accent);
    border-radius: 2px;
    line-height: 1.35;
  }

  /* Compact height modifier for motion cards */
  .testimonial-card--motion {
    padding: 16px 18px;
  }

  /* Responsive Rules */
  @media (max-width: 1024px) {
    .testimonials__grid--cols-3 .testimonial-card {
      grid-column: span 6;
    }
  }

  @media (max-width: 768px) {
    .testimonials {
      padding-top: 32px;
      padding-bottom: 32px;
    }

    .testimonials__grid--cols-2 .testimonial-card,
    .testimonials__grid--cols-3 .testimonial-card {
      grid-column: span 12;
    }

    .testimonial-card {
      padding: 14px 16px;
    }

    .testimonial-card__quote {
      font-size: 13px;
      margin-bottom: 12px;
    }
  }
</style>
